<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Windows client. Windows App SDK 2.4.0 is the ALPHA baseline (config/version-policy.yaml). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
  </ItemGroup>

  <!-- Runtime/infrastructure. Aligned to the .NET 10.0.11 ALPHA runtime baseline. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
  </ItemGroup>

  <!--
    Persistence. PostgreSQL is canonical (docs/02_ARCHITECTURE.md); EF Core with
    Npgsql is the default access path per CLAUDE.md section 2.
  -->
  <ItemGroup>
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!--
      Pinned to the EF Core version the Npgsql provider is built against. A newer
      Design package drags in a mismatched EF Core and the assembly versions stop
      unifying.
    -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4" />
  </ItemGroup>

  <!--
    API contract. ASP.NET Core's built-in OpenAPI support; no third-party
    generator and no UI, because the requirement is a machine-readable contract
    (CLAUDE.md principle 6).
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.11" />
  </ItemGroup>

  <!--
    Local client cache. SQLite is never canonical (CLAUDE.md section 2): it holds a
    read-through copy and a durable write queue so the client is useful offline.
    SQLCipher provides page-level encryption; the key is protected by Windows DPAPI
    and never committed or derived from anything in the repository
    (docs/adr/ADR-0015-local-cache-encryption.md).
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.11" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>

  <!--
    Observability. ADR-0004 deferred OpenTelemetry until there was a distributed
    failure path worth tracing; ADR-0016 records that M3 is that milestone. No
    vendor and no collector: exporters are registered only when an OTLP endpoint is
    configured, so the operational surface stays at zero until somebody looks.
  -->
  <ItemGroup>
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
  </ItemGroup>

  <!--
    F# 10 core library for the M7 deal-rules kernel (ADR-0021). Referenced
    explicitly rather than left to the SDK's implicit reference: the implicit one
    resolves to the compiler's own copy inside the SDK directory, which compiles
    but is never copied to a consuming project's output, so anything calling the
    kernel fails at run time with a missing assembly. Version 10.0.100 is the
    released F# 10 library, matching the pinned F# baseline in CLAUDE.md.
  -->
  <ItemGroup>
    <PackageVersion Include="FSharp.Core" Version="10.0.100" />
  </ItemGroup>

  <!-- Test stack. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
  </ItemGroup>

</Project>
