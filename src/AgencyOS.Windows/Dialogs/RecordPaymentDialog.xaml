<ContentDialog
    x:Class="AgencyOS.Windows.Dialogs.RecordPaymentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Record payment"
    PrimaryButtonText="Record payment"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False">

    <ScrollViewer MaxHeight="620">
        <StackPanel Spacing="10" MinWidth="620">

            <!--
                "Record", never "collect". A bank moved the money; somebody is
                writing down that it happened (ADR-0023).
            -->
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                       Opacity="0.75"
                       Text="AgencyOS records that money moved. It does not move any, and it does not chase anybody for it." />

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="170" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="AmountBox" Grid.Column="0" Header="Amount received"
                         PlaceholderText="0.00" TextChanged="OnAmountChanged" />
                <TextBox x:Name="CurrencyBox" Grid.Column="1" Header="Currency"
                         PlaceholderText="USD" MaxLength="3" TextChanged="OnCurrencyChanged" />
                <CalendarDatePicker x:Name="ReceivedPicker" Grid.Column="2" Header="Received on"
                                    PlaceholderText="The day it moved"
                                    DateChanged="OnReceivedChanged" />
            </Grid>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="DirectionBox" Grid.Column="0" Header="Direction"
                          HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Incoming" Tag="Incoming" IsSelected="True" />
                    <ComboBoxItem Content="Outgoing" Tag="Outgoing" />
                </ComboBox>

                <ComboBox x:Name="MethodBox" Grid.Column="1" Header="Method"
                          HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Bank transfer" Tag="BankTransfer" IsSelected="True" />
                    <ComboBoxItem Content="Cheque" Tag="Cheque" />
                    <ComboBoxItem Content="Card" Tag="Card" />
                    <ComboBoxItem Content="Cash" Tag="Cash" />
                    <ComboBoxItem Content="Offset" Tag="Offset" />
                    <ComboBoxItem Content="Other" Tag="Other" />
                </ComboBox>
            </Grid>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="PayerBox" Grid.Column="0" Header="Payer"
                         PlaceholderText="Who paid, as reported" />

                <!--
                    A bank reference is not assumed unique. Two genuinely different
                    payments can carry the same remittance text, so a match is
                    reported back as a possible duplicate and never refuses the
                    record (ADR-0023).
                -->
                <TextBox x:Name="ReferenceBox" Grid.Column="1"
                         Header="Bank or remittance reference" PlaceholderText="Optional" />
            </Grid>

            <TextBlock Text="What this payment is for"
                       Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" />

            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                       Opacity="0.75"
                       Text="Nothing is matched automatically. Anything you do not allocate stays unapplied until somebody says what it is for." />

            <ListView x:Name="AllocationList"
                      AutomationProperties.Name="Allocations" MaxHeight="180" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="2,4" ColumnSpacing="8" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Description}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Text="{Binding AmountDisplay}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="ReceivableBox" AutomationProperties.Name="Receivable" Grid.Column="0" HorizontalAlignment="Stretch"
                          PlaceholderText="Choose a receivable" />
                <TextBox x:Name="LineAmountBox" Grid.Column="1" PlaceholderText="0.00" />
                <Button x:Name="AddLineButton" Grid.Column="2" Content="Add"
                        Click="OnAddAllocationClick" />
                <Button x:Name="ClearLinesButton" Grid.Column="3" Content="Clear"
                        Click="OnClearAllocationsClick" />
            </Grid>

            <!--
                The three figures together, before the commit. A dialog that took an
                amount and said "saved" would let somebody record eighty thousand
                against a hundred-thousand receivable and walk away believing the
                account was settled (ADR-0023).
            -->
            <Border Padding="10" CornerRadius="6"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Received" Opacity="0.6"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="ReceivedText"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Allocated" Opacity="0.6"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="AllocatedText"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Unapplied" Opacity="0.6"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="UnappliedText"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="PreviewText" TextWrapping="Wrap" Opacity="0.8"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Border>

            <InfoBar x:Name="OverAllocatedBar" Severity="Error" IsOpen="False" IsClosable="False"
                     Title="More allocated than arrived"
                     Message="The allocations come to more than the amount received. Reduce a line, or record the larger amount if that is what actually moved." />

            <TextBox x:Name="NotesBox" Header="Notes" PlaceholderText="Optional"
                     TextWrapping="Wrap" AcceptsReturn="True" Height="60" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
