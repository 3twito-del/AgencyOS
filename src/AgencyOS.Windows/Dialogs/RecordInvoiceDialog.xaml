<ContentDialog
    x:Class="AgencyOS.Windows.Dialogs.RecordInvoiceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Record invoice"
    PrimaryButtonText="Record"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False">

    <ScrollViewer MaxHeight="580">
        <StackPanel Spacing="10" MinWidth="600">
            <TextBlock x:Name="HeadlineText" Style="{StaticResource BodyStrongTextBlockStyle}"
                       TextWrapping="Wrap" />

            <!--
                Records that an invoice exists. Does not produce one, hold one or
                send one: there is no document store and no transport anywhere in
                this build (ADR-0023).
            -->
            <InfoBar Severity="Informational" IsOpen="True" IsClosable="False"
                     Title="AgencyOS records the invoice. It does not send it."
                     Message="There is no document and no transport here. Somebody issues the invoice elsewhere and records that fact, along with the number they used." />

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="170" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="ReferenceBox" Grid.Column="0" Header="Invoice number"
                         PlaceholderText="Your own numbering" TextChanged="OnTextChanged" />
                <TextBox x:Name="CurrencyBox" Grid.Column="1" Header="Currency"
                         PlaceholderText="USD" MaxLength="3" TextChanged="OnTextChanged" />
                <CalendarDatePicker x:Name="DuePicker" Grid.Column="2" Header="Due on"
                                    PlaceholderText="Optional" />
            </Grid>

            <!--
                AgencyOS assigns no invoice number. Numbering carries statutory
                weight that varies by jurisdiction, and the system is in no position
                to claim compliance with any of them (ADR-0023).
            -->
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Text="AgencyOS does not assign invoice numbers. Invoice numbering carries legal requirements that differ by jurisdiction, so the number is the one you actually used." />

            <TextBlock Text="What is being billed"
                       Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" />

            <ListView x:Name="LineList"
                      AutomationProperties.Name="Journal lines" MaxHeight="180" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="2,4" ColumnSpacing="8" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Description}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Text="{Binding AmountDisplay}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="ReceivableBox" AutomationProperties.Name="Receivable" Grid.Column="0" HorizontalAlignment="Stretch"
                          PlaceholderText="Choose a receivable" />
                <TextBox x:Name="LineAmountBox" Grid.Column="1" PlaceholderText="0.00" />
                <Button Grid.Column="2" Content="Add" Click="OnAddClick" />
                <Button Grid.Column="3" Content="Clear" Click="OnClearClick" />
            </Grid>

            <TextBlock x:Name="TotalText" Style="{StaticResource BodyStrongTextBlockStyle}" />

            <TextBox x:Name="NotesBox" Header="Notes" PlaceholderText="Optional"
                     TextWrapping="Wrap" AcceptsReturn="True" Height="60" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
