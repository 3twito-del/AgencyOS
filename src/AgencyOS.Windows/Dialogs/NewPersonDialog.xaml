<ContentDialog
    x:Class="AgencyOS.Windows.Dialogs.NewPersonDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="New person"
    PrimaryButtonText="Create"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="8" Width="380">
        <!--
            A refused create is shown here and the dialog stays open, so the entry
            can be corrected and retried without retyping it (AOS-R002-010). When
            the refusal is about one field, that field points at this bar
            (AOS-R002-011).
        -->
        <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="False"
                 Title="Could not create the person" />

        <TextBox x:Name="FirstNameBox" Header="First name" TextChanged="OnEntryChanged" />
        <TextBox x:Name="LastNameBox" Header="Last name"  TextChanged="OnEntryChanged" />
        <TextBox x:Name="TitleBox" Header="Title" PlaceholderText="Literary Agent"  TextChanged="OnEntryChanged" />
        <TextBox x:Name="EmailBox" Header="Email"  TextChanged="OnEntryChanged" />
        <TextBox x:Name="PhoneBox" Header="Phone"  TextChanged="OnEntryChanged" />
        <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" Height="70" TextWrapping="Wrap"
                 TextChanged="OnEntryChanged" />
    </StackPanel>
</ContentDialog>
