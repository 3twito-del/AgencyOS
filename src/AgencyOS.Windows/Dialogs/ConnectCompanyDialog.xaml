<ContentDialog
    x:Class="AgencyOS.Windows.Dialogs.ConnectCompanyDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Connect to a company"
    PrimaryButtonText="Connect"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="8" Width="420">
        <ComboBox x:Name="TypeBox" Header="Relationship" HorizontalAlignment="Stretch" SelectedIndex="0">
            <x:String>Employment</x:String>
            <x:String>Affiliation</x:String>
            <x:String>Advisor</x:String>
            <x:String>Counsel</x:String>
            <x:String>Other</x:String>
        </ComboBox>

        <TextBox x:Name="SearchBox" Header="Find company" KeyDown="OnSearchKeyDown" />

        <ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed" />

        <ListView
            x:Name="CompanyList"
            Height="220"
            SelectionMode="Single"
            ItemTemplate="{StaticResource CompanyRowTemplate}" />

        <TextBox x:Name="NotesBox" Header="Notes" />

        <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="False" Title="Could not connect" />
    </StackPanel>
</ContentDialog>
