<ContentDialog
    x:Class="AgencyOS.Windows.Dialogs.NewCompanyDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="New company"
    PrimaryButtonText="Create"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="8" Width="380">
        <!--
            A refused create is shown here and the dialog stays open, so the entry
            can be corrected and retried without retyping it (AOS-R002-010). When
            the refusal is about one field, that field points at this bar
            (AOS-R002-011).
        -->
        <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="False"
                 Title="Could not create the company" />

        <TextBox x:Name="NameBox" Header="Name" TextChanged="OnEntryChanged" />

        <ComboBox x:Name="TypeBox" Header="Type" HorizontalAlignment="Stretch" SelectedIndex="0">
            <x:String>Studio</x:String>
            <x:String>Network</x:String>
            <x:String>Streamer</x:String>
            <x:String>ProductionCompany</x:String>
            <x:String>ManagementCompany</x:String>
            <x:String>TalentAgency</x:String>
            <x:String>LawFirm</x:String>
            <x:String>Publisher</x:String>
            <x:String>Brand</x:String>
            <x:String>Other</x:String>
        </ComboBox>

        <TextBox x:Name="LegalNameBox" Header="Legal name" TextChanged="OnEntryChanged" />
        <TextBox x:Name="WebsiteBox" Header="Website" TextChanged="OnEntryChanged" />
        <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" Height="70" TextWrapping="Wrap"
                 TextChanged="OnEntryChanged" />
    </StackPanel>
</ContentDialog>
