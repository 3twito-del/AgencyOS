<ContentDialog
    x:Class="AgencyOS.Windows.Dialogs.ChangeVerificationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Change what corroboration this claim has"
    PrimaryButtonText="Record"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="10" MinWidth="500">
        <TextBlock x:Name="ClaimText" TextWrapping="Wrap"
                   Style="{StaticResource BodyStrongTextBlockStyle}" />

        <!--
            The one thing this dialog exists to prevent. Corroborated means other
            evidence agrees; it does not mean the claim is true, and AgencyOS offers
            no word that says it is.
        -->
        <InfoBar Severity="Informational" IsOpen="True" IsClosable="False"
                 Title="There is no “verified”"
                 Message="Corroborated means independent evidence agrees with this claim. It does not mean the claim is true, and AgencyOS will never say that it is." />

        <ComboBox x:Name="VerificationBox" Header="State" MinWidth="300"
                  SelectionChanged="OnStateChanged">
            <ComboBoxItem Content="Unverified — nothing else has been found" Tag="Unverified" />
            <ComboBoxItem Content="Corroborated — other evidence agrees" Tag="Corroborated" />
            <ComboBoxItem Content="Disputed — other evidence disagrees" Tag="Disputed" />
            <ComboBoxItem Content="Retracted — the source withdrew it" Tag="Retracted" />
        </ComboBox>

        <TextBlock x:Name="MeaningText" TextWrapping="Wrap" Opacity="0.7"
                   Style="{StaticResource CaptionTextBlockStyle}" />

        <TextBox x:Name="NoteBox" Header="Note (optional)" TextWrapping="Wrap"
                 AcceptsReturn="True" Height="80"
                 PlaceholderText="What changed, and on what evidence" />
    </StackPanel>
</ContentDialog>
