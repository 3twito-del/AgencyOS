<ContentDialog
    x:Class="AgencyOS.Windows.Dialogs.MoveTargetDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Move target"
    PrimaryButtonText="Move"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="10" MinWidth="420">
        <TextBlock x:Name="CurrentText" Style="{StaticResource BodyStrongTextBlockStyle}" />

        <ComboBox x:Name="StageBox" Header="New stage" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="Identified" Tag="Identified" />
            <ComboBoxItem Content="Approved" Tag="Approved" />
            <ComboBoxItem Content="Contacted" Tag="Contacted" />
            <ComboBoxItem Content="Engaged" Tag="Engaged" />
            <ComboBoxItem Content="Interested" Tag="Interested" />
            <ComboBoxItem Content="Advanced" Tag="Advanced" />
            <ComboBoxItem Content="Passed" Tag="Passed" />
            <ComboBoxItem Content="Withdrawn" Tag="Withdrawn" />
            <ComboBoxItem Content="Exhausted" Tag="Exhausted" />
        </ComboBox>

        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75" TextWrapping="Wrap"
                   Text="Advanced means commercial discussion has become concrete. It records that and nothing about terms; offers and deals arrive in a later milestone." />

        <TextBox x:Name="NoteBox" Header="Note" PlaceholderText="For the history" />
    </StackPanel>
</ContentDialog>
