<ContentDialog
    x:Class="AgencyOS.Windows.Dialogs.FinanceReasonDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Record the reason"
    PrimaryButtonText="Record"
    CloseButtonText="Cancel"
    DefaultButton="Close"
    IsPrimaryButtonEnabled="False">

    <StackPanel Spacing="10" MinWidth="460">
        <TextBlock x:Name="HeadlineText" Style="{StaticResource BodyStrongTextBlockStyle}"
                   TextWrapping="Wrap" />

        <InfoBar x:Name="ConsequenceBar" Severity="Warning" IsOpen="True" IsClosable="False"
                 Title="This is a financial act" />

        <TextBox x:Name="ReasonBox" Header="Reason" TextWrapping="Wrap" AcceptsReturn="True"
                 Height="90" TextChanged="OnReasonChanged" />
    </StackPanel>
</ContentDialog>
