<ContentDialog
    x:Class="AgencyOS.Windows.Dialogs.OpenResearchCaseDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Open a research case"
    PrimaryButtonText="Open"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False">

    <StackPanel Spacing="10" MinWidth="520">
        <!--
            A case is organized around a question. Not a topic and not a folder: a
            question is the thing that can eventually be answered, and a case whose
            question nobody wrote down is a pile of links.
        -->
        <TextBox x:Name="QuestionBox" Header="The question" TextWrapping="Wrap"
                 AcceptsReturn="True" Height="80" TextChanged="OnRequiredChanged"
                 PlaceholderText="What are we trying to find out?" />

        <TextBox x:Name="ContextBox" Header="Context (optional)" TextWrapping="Wrap"
                 AcceptsReturn="True" Height="90"
                 PlaceholderText="Why it matters now, and what is already known" />

        <ComboBox x:Name="SensitivityBox" Header="Classification" MinWidth="240">
            <ComboBoxItem Content="Internal" Tag="Internal" IsSelected="True" />
            <ComboBoxItem Content="Confidential" Tag="Confidential" />
            <ComboBoxItem Content="Source sensitive" Tag="SourceSensitive" />
            <ComboBoxItem Content="Restricted" Tag="Restricted" />
        </ComboBox>

        <TextBlock TextWrapping="Wrap" Opacity="0.65"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Text="A case gathers sources, signals, theses, predictions and tasks. It holds no findings of its own: what the research concluded belongs in a thesis, where it can be revised and argued with." />
    </StackPanel>
</ContentDialog>
