<ContentDialog
    x:Class="AgencyOS.Windows.Dialogs.PostJournalEntryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Post journal entry"
    PrimaryButtonText="Post"
    CloseButtonText="Cancel"
    DefaultButton="Close"
    IsPrimaryButtonEnabled="False">

    <ScrollViewer MaxHeight="600">
        <StackPanel Spacing="10" MinWidth="620">

            <!--
                The narrowest surface in the milestone. Every other posting is a
                consequence of a business act the system made in the same
                transaction; this is the one route by which a person writes an entry
                directly (ADR-0023).
            -->
            <InfoBar Severity="Warning" IsOpen="True" IsClosable="False"
                     Title="A hand-written entry"
                     Message="Every other entry in AgencyOS is written by the act that caused it. This one is yours, it cannot be edited afterwards, and correcting it means posting the opposite entry beside it." />

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="170" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="MemoBox" Grid.Column="0" Header="Memo"
                         PlaceholderText="What this entry is" TextChanged="OnTextChanged" />
                <TextBox x:Name="CurrencyBox" Grid.Column="1" Header="Currency"
                         PlaceholderText="USD" MaxLength="3" TextChanged="OnTextChanged" />
                <CalendarDatePicker x:Name="OccurredPicker" Grid.Column="2" Header="Occurred on"
                                    PlaceholderText="The economic date"
                                    DateChanged="OnDateChanged" />
            </Grid>

            <ListView x:Name="LineList"
                      AutomationProperties.Name="Journal lines" MaxHeight="200" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="2,4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Account}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Side}"
                                       VerticalAlignment="Center" Opacity="0.7" />
                            <TextBlock Grid.Column="2" Text="{Binding AmountDisplay}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="AccountBox" Grid.Column="0" HorizontalAlignment="Stretch"
                          PlaceholderText="Account">
                    <ComboBoxItem Content="Cash" Tag="Cash" />
                    <ComboBoxItem Content="Accounts receivable" Tag="AccountsReceivable" />
                    <ComboBoxItem Content="Client funds payable" Tag="ClientFundsPayable" />
                    <ComboBoxItem Content="Commission revenue" Tag="CommissionRevenue" />
                    <ComboBoxItem Content="Unapplied cash" Tag="UnappliedCash" />
                    <ComboBoxItem Content="Write-off expense" Tag="WriteOffExpense" />
                    <ComboBoxItem Content="Deduction expense" Tag="DeductionExpense" />
                    <ComboBoxItem Content="Suspense" Tag="Suspense" />
                </ComboBox>

                <!--
                    Side and a positive amount, never a signed number. Debit and
                    credit are what the entry means; a minus sign is folklore that
                    reads differently on an asset than on a liability (ADR-0023).
                -->
                <ComboBox x:Name="SideBox" Grid.Column="1" HorizontalAlignment="Stretch"
                          PlaceholderText="Side">
                    <ComboBoxItem Content="Debit" Tag="Debit" IsSelected="True" />
                    <ComboBoxItem Content="Credit" Tag="Credit" />
                </ComboBox>

                <TextBox x:Name="LineAmountBox" Grid.Column="2" PlaceholderText="0.00" />
                <Button Grid.Column="3" Content="Add" Click="OnAddClick" />
                <Button Grid.Column="4" Content="Clear" Click="OnClearClick" />
            </Grid>

            <Border Padding="10" CornerRadius="6"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Debits" Opacity="0.6"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Name="DebitText"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Credits" Opacity="0.6"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Name="CreditText"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Balance" Opacity="0.6"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock x:Name="BalanceText"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <InfoBar x:Name="UnbalancedBar" Severity="Error" IsOpen="False" IsClosable="False"
                     Title="Does not balance"
                     Message="Debits and credits must come to the same figure. The database refuses an unbalanced entry, so this is checked here first rather than failing at the server." />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
