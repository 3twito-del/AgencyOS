<ContentDialog
    x:Class="AgencyOS.Windows.Dialogs.RecordForecastDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="State a new probability"
    PrimaryButtonText="Record"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="10" MinWidth="500">
        <TextBlock x:Name="StatementText" TextWrapping="Wrap"
                   Style="{StaticResource BodyStrongTextBlockStyle}" />

        <TextBlock x:Name="CurrentText" Opacity="0.7" TextWrapping="Wrap"
                   Style="{StaticResource CaptionTextBlockStyle}" />

        <!--
            The previous forecast is not replaced. Every revision is kept, because the
            history is what calibration measures and because a forecaster who quietly
            revised upward the day before resolution would otherwise look prescient.
        -->
        <InfoBar Severity="Informational" IsOpen="True" IsClosable="False"
                 Title="The previous forecast stays on the record"
                 Message="This adds a revision. Nothing overwrites what you said before." />

        <Slider x:Name="ProbabilitySlider" Minimum="0" Maximum="100" StepFrequency="1"
                TickFrequency="10" TickPlacement="Outside" ValueChanged="OnProbabilityChanged" />

        <TextBlock x:Name="ProbabilityText" Opacity="0.75"
                   Style="{StaticResource CaptionTextBlockStyle}" />

        <TextBox x:Name="RationaleBox" Header="What changed (optional)" TextWrapping="Wrap"
                 AcceptsReturn="True" Height="80" />
    </StackPanel>
</ContentDialog>
