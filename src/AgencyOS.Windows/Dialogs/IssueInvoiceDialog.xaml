<ContentDialog
    x:Class="AgencyOS.Windows.Dialogs.IssueInvoiceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Issue invoice"
    PrimaryButtonText="Issue"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False">

    <StackPanel Spacing="10" MinWidth="480">
        <TextBlock x:Name="HeadlineText" Style="{StaticResource BodyStrongTextBlockStyle}"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="InvoiceText" Opacity="0.75" TextWrapping="Wrap"
                   Style="{StaticResource CaptionTextBlockStyle}" />

        <!--
            The same sentence the Invoices tab carries. Issuing records that
            somebody issued it, exactly as a submission records that material went
            out; AgencyOS holds no document and sends nothing (ADR-0023).
        -->
        <InfoBar Severity="Informational" IsOpen="True" IsClosable="False"
                 Title="Recorded, not sent"
                 Message="This records that the invoice was issued. AgencyOS does not produce a document, send it or confirm it arrived, and issuing freezes the lines." />

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="190" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="ReferenceBox" Grid.Column="0" Header="Invoice number"
                     AutomationProperties.Name="Invoice number"
                     PlaceholderText="The number on the document that went out"
                     TextChanged="OnReferenceChanged" />
            <CalendarDatePicker x:Name="IssuedPicker" Grid.Column="1" Header="Issued on"
                                AutomationProperties.Name="Issued on"
                                HorizontalAlignment="Stretch"
                                DateChanged="OnDateChanged" />
        </Grid>

        <TextBlock x:Name="NumberingText" Opacity="0.7" TextWrapping="Wrap"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Text="AgencyOS assigns no invoice number. Numbering carries statutory weight that varies by jurisdiction, and the system is in no position to claim compliance with any of it." />
    </StackPanel>
</ContentDialog>
