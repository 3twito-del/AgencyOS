<ContentDialog
    x:Class="AgencyOS.Windows.Dialogs.LinkRecordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Link to a record"
    PrimaryButtonText="Link"
    CloseButtonText="Cancel"
    DefaultButton="Close"
    IsPrimaryButtonEnabled="False">

    <StackPanel Spacing="10" MinWidth="480">
        <TextBlock x:Name="HeadlineText" Style="{StaticResource BodyStrongTextBlockStyle}"
                   TextWrapping="Wrap" />

        <ComboBox x:Name="TargetBox" Header="Record type" MinWidth="260"
                  PlaceholderText="Choose one" SelectionChanged="OnChanged" />

        <TextBox x:Name="TargetIdBox" Header="Record identifier" TextChanged="OnChanged"
                 PlaceholderText="00000000-0000-0000-0000-000000000000" />

        <TextBox x:Name="NoteBox" Header="Note (optional)" TextWrapping="Wrap"
                 AcceptsReturn="True" Height="70" />

        <!--
            A link is a statement about relevance, not a grant of access. Somebody
            who can see the deal does not thereby gain the right to open a
            privileged document filed against it (ADR-0025).
        -->
        <InfoBar x:Name="ConsequenceBar" Severity="Informational" IsOpen="True" IsClosable="False"
                 Title="Linking does not grant access"
                 Message="A link records that this bears on that record. Whoever can open the record still needs their own permission to open this." />
    </StackPanel>
</ContentDialog>
