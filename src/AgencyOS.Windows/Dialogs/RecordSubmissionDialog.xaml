<ContentDialog
    x:Class="AgencyOS.Windows.Dialogs.RecordSubmissionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Record submission"
    PrimaryButtonText="Record"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="10" MinWidth="460">
        <TextBlock x:Name="TargetText" Style="{StaticResource BodyStrongTextBlockStyle}" />

        <InfoBar Severity="Informational" IsOpen="True" IsClosable="False"
                 Title="Recorded, not sent"
                 Message="AgencyOS is recording that you sent this. It does not send anything itself and cannot confirm it arrived." />

        <!--
            Date and time, because this field is an instant and the operator has to
            be able to see and set the whole of it (AOS-R002-026).
        -->
        <DatePicker x:Name="SentPicker" Header="Sent — date" />
        <TimePicker x:Name="SentTimePicker" Header="Sent — time" ClockIdentifier="24HourClock" />

        <ComboBox x:Name="ChannelBox" Header="How" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="Email" Tag="Email" />
            <ComboBoxItem Content="Portal" Tag="Portal" />
            <ComboBoxItem Content="Courier" Tag="Courier" />
            <ComboBoxItem Content="In person" Tag="InPerson" />
            <ComboBoxItem Content="Phone" Tag="Phone" />
            <ComboBoxItem Content="Other" Tag="Other" />
        </ComboBox>

        <TextBox x:Name="SubjectBox" Header="Subject" PlaceholderText="What it was called" />

        <StackPanel Spacing="4">
            <ComboBox x:Name="MaterialBox" Header="Material" HorizontalAlignment="Stretch"
                      DisplayMemberPath="Label" SelectionChanged="OnMaterialChanged" />
            <TextBlock x:Name="SnapshotHint" Style="{StaticResource CaptionTextBlockStyle}"
                       Opacity="0.75" TextWrapping="Wrap"
                       Text="The material's title and version label are copied into this record as they read now, so editing it later does not rewrite what you sent." />
        </StackPanel>

        <DatePicker x:Name="ResponsePicker" Header="Reply expected by" />

        <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" Height="70" TextWrapping="Wrap" />

        <CheckBox x:Name="FollowUpBox" Content="Create a follow-up task" IsChecked="True" />

        <TextBox x:Name="FollowUpTitleBox" Header="Follow-up" Text="Chase for a response" />
    </StackPanel>
</ContentDialog>
