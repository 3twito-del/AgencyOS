<ContentDialog
    x:Class="AgencyOS.Windows.Dialogs.AllocatePaymentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Allocate payment"
    PrimaryButtonText="Allocate"
    CloseButtonText="Cancel"
    DefaultButton="Close"
    IsPrimaryButtonEnabled="False">

    <ScrollViewer MaxHeight="560">
        <StackPanel Spacing="10" MinWidth="600">
            <TextBlock x:Name="HeadlineText" Style="{StaticResource BodyStrongTextBlockStyle}"
                       TextWrapping="Wrap" />

            <!--
                "Allocate", never "match". Nothing here is matched automatically:
                the operator says what the money is for (ADR-0023).
            -->
            <TextBlock x:Name="UnappliedText" Opacity="0.75" TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}" />

            <ListView x:Name="AllocationList" MaxHeight="200" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="2,4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Description}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Text="{Binding AmountDisplay}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="ReceivableBox" Grid.Column="0" HorizontalAlignment="Stretch"
                          PlaceholderText="Choose a receivable" />
                <TextBox x:Name="LineAmountBox" Grid.Column="1" PlaceholderText="0.00" />
                <Button Grid.Column="2" Content="Add" Click="OnAddClick" />
                <Button Grid.Column="3" Content="Clear" Click="OnClearClick" />
            </Grid>

            <TextBlock x:Name="PreviewText" TextWrapping="Wrap"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />

            <InfoBar x:Name="OverBar" Severity="Error" IsOpen="False" IsClosable="False"
                     Title="More than is unapplied"
                     Message="These allocations come to more than this payment has left to apply." />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
