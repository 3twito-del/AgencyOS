<ContentDialog
    x:Class="AgencyOS.Windows.Dialogs.LinkResearchItemDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Attach something to this case"
    PrimaryButtonText="Attach"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False">

    <StackPanel Spacing="10" MinWidth="480">
        <ComboBox x:Name="KindBox" Header="What kind of thing" MinWidth="260"
                  SelectionChanged="OnKindChanged">
            <ComboBoxItem Content="A source" Tag="Source" IsSelected="True" />
            <ComboBoxItem Content="A signal" Tag="Signal" />
            <ComboBoxItem Content="A thesis" Tag="Thesis" />
            <ComboBoxItem Content="A prediction" Tag="Prediction" />
            <ComboBoxItem Content="A task" Tag="Task" />
        </ComboBox>

        <ComboBox x:Name="ItemBox" Header="Which one" HorizontalAlignment="Stretch"
                  DisplayMemberPath="Label" SelectionChanged="OnRequiredChanged" />

        <ProgressBar x:Name="ItemBusy" IsIndeterminate="True" Visibility="Collapsed"
                     AutomationProperties.Name="Loading what can be attached" />

        <TextBlock x:Name="ItemHint" Style="{StaticResource CaptionTextBlockStyle}"
                   Opacity="0.75" TextWrapping="Wrap" />

        <TextBox x:Name="NoteBox" Header="Note (optional)"
                 PlaceholderText="Why it is attached" />

        <TextBlock TextWrapping="Wrap" Opacity="0.65"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Text="A case gathers work that already exists elsewhere. Attaching does not copy anything: the source, signal, thesis, prediction or task stays where it lives and stays under its own permissions." />
    </StackPanel>
</ContentDialog>
