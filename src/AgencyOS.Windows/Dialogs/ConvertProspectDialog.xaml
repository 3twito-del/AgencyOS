<ContentDialog
    x:Class="AgencyOS.Windows.Dialogs.ConvertProspectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Convert to client"
    PrimaryButtonText="Sign"
    CloseButtonText="Cancel"
    DefaultButton="Close"
    IsPrimaryButtonEnabled="False">

    <StackPanel Spacing="12" MinWidth="400">
        <TextBlock x:Name="SubjectText" TextWrapping="Wrap" />

        <CalendarDatePicker x:Name="StartPicker" Header="Representation starts"
                            HorizontalAlignment="Stretch" DateChanged="OnRequiredChanged" />

        <TextBlock Text="Scopes" Style="{StaticResource BodyStrongTextBlockStyle}" />

        <!--
            Scope is not optional in practice: representing somebody "for
            everything" without saying so is how disputes start. At least one must
            be chosen before the dialog will sign.
        -->
        <StackPanel Spacing="4">
            <CheckBox x:Name="FilmBox" Content="Film" Click="OnRequiredChanged" />
            <CheckBox x:Name="TelevisionBox" Content="Television" Click="OnRequiredChanged" />
            <CheckBox x:Name="LiteraryBox" Content="Literary" Click="OnRequiredChanged" />
            <CheckBox x:Name="ActingBox" Content="Acting" Click="OnRequiredChanged" />
            <CheckBox x:Name="DirectingBox" Content="Directing" Click="OnRequiredChanged" />
            <CheckBox x:Name="ProducingBox" Content="Producing" Click="OnRequiredChanged" />
            <CheckBox x:Name="TheatreBox" Content="Theatre" Click="OnRequiredChanged" />
            <CheckBox x:Name="BooksBox" Content="Books" Click="OnRequiredChanged" />
        </StackPanel>

        <CheckBox x:Name="ExclusiveBox" Content="Exclusive within these scopes" IsThreeState="True"
                  IsChecked="{x:Null}" />

        <TextBox x:Name="TerritoryBox" Header="Territory" PlaceholderText="Worldwide" />

        <TextBlock
            Text="Signing creates the representation and closes the pursuit together. Retrying after a lost connection is safe: it will not sign twice."
            TextWrapping="Wrap"
            Opacity="0.65"
            Style="{StaticResource CaptionTextBlockStyle}" />
    </StackPanel>
</ContentDialog>
