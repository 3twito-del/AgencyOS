<ContentDialog
    x:Class="AgencyOS.Windows.Dialogs.AddIntelligenceSubjectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Say what this is about"
    PrimaryButtonText="Add"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False">

    <StackPanel Spacing="10" MinWidth="480">
        <TextBlock x:Name="HeadlineText" TextWrapping="Wrap"
                   Style="{StaticResource BodyStrongTextBlockStyle}" />

        <ComboBox x:Name="KindBox" Header="What kind of record" MinWidth="260">
            <ComboBoxItem Content="Person" Tag="Person" IsSelected="True" />
            <ComboBoxItem Content="Company" Tag="Company" />
            <ComboBoxItem Content="Talent profile" Tag="TalentProfile" />
            <ComboBoxItem Content="Project" Tag="Project" />
            <ComboBoxItem Content="Source property" Tag="SourceProperty" />
            <ComboBoxItem Content="Package" Tag="Package" />
            <ComboBoxItem Content="Project role" Tag="ProjectRole" />
            <ComboBoxItem Content="Opportunity" Tag="Opportunity" />
            <ComboBoxItem Content="Deal" Tag="Deal" />
            <ComboBoxItem Content="Contract" Tag="Contract" />
        </ComboBox>

        <TextBox x:Name="IdBox" Header="Record identifier" TextChanged="OnRequiredChanged"
                 PlaceholderText="00000000-0000-0000-0000-000000000000" />

        <TextBox x:Name="NoteBox" Header="Note (optional)"
                 PlaceholderText="How this record is involved" />

        <!--
            The identifier points at a real record and the database enforces it with a
            composite key per kind, so a subject can never name another tenant's row
            and can never point at something that was removed.
        -->
        <TextBlock TextWrapping="Wrap" Opacity="0.65"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Text="The record must already exist in this organization. AgencyOS refuses a subject that names something it cannot find." />
    </StackPanel>
</ContentDialog>
