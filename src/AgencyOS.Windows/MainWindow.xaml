<Window
    x:Class="AgencyOS.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="AgencyOS">

    <Grid>
        <!--
            PaneDisplayMode is Auto, not Left. Left pins the 220-pixel pane at
            every size, which is why a 900x700 window spent a third of its width
            on navigation and pushed the detail pane - every action on the surface
            - off screen with nothing to indicate it was missing (AOS-R001-007).
            Auto keeps the expanded pane on a desktop-sized window and compacts it
            below WinUI's own breakpoint, which is the behaviour the control was
            built with.
        -->
        <muxc:NavigationView
            x:Name="Navigation"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Auto"
            OpenPaneLength="220"
            SelectionChanged="OnNavigationSelectionChanged">

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Command Center" Tag="command-center" AccessKey="1" />
                <muxc:NavigationViewItem Content="People" Tag="people" AccessKey="2" />
                <muxc:NavigationViewItem Content="Companies" Tag="companies" AccessKey="3" />
                <muxc:NavigationViewItem Content="Talent" Tag="talent" AccessKey="4" />
                <muxc:NavigationViewItem Content="Prospects" Tag="prospects" AccessKey="5" />
                <muxc:NavigationViewItem Content="Projects" Tag="projects" AccessKey="6" />
                <muxc:NavigationViewItem Content="Packages" Tag="packages" AccessKey="7" />
                <muxc:NavigationViewItem Content="Pipeline" Tag="pipeline" AccessKey="8" />
                <muxc:NavigationViewItem Content="Deals" Tag="deals" AccessKey="0" />
                <muxc:NavigationViewItem Content="Contracts" Tag="contracts" AccessKey="C" />
                <muxc:NavigationViewItem Content="Finance" Tag="finance" AccessKey="F" />
                <muxc:NavigationViewItem Content="Documents" Tag="documents" AccessKey="D" />
                <muxc:NavigationViewItem Content="Communications" Tag="communications" AccessKey="E" />
                <muxc:NavigationViewItem Content="Intelligence" Tag="intelligence" AccessKey="I" />
                <muxc:NavigationViewItem Content="AI" Tag="ai" AccessKey="A" />
                <muxc:NavigationViewItem Content="Saved Views" Tag="saved-views" AccessKey="9" />
                <muxc:NavigationViewItem Content="Sync and Offline" Tag="sync" AccessKey="S" />
            </muxc:NavigationView.MenuItems>

            <muxc:NavigationView.PaneFooter>
                <!--
                    Connection state belongs where the user can always see it. An
                    application that is quietly offline is one that loses
                    somebody's afternoon.

                    It is opaque and it does not wrap. Three wrapping captions
                    holding a URL and a tenant identifier grew to five lines, the
                    destination list scrolled underneath them, and the selected
                    item could end up completely hidden behind the text - Sync and
                    Offline was unreadable while it was the current page
                    (AOS-R001-013).

                    Trimming keeps the footer one predictable height, so the pane
                    can give the rest to destinations; the background stops
                    anything showing through; and the full text is still available
                    on hover for the two lines that get shortened.
                -->
                <StackPanel
                    Padding="12,8"
                    Spacing="2"
                    Background="{ThemeResource NavigationViewDefaultPaneBackground}">
                    <TextBlock
                        x:Name="SyncText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="ConnectionText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis"
                        Opacity="0.7" />
                    <TextBlock
                        x:Name="BuildText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis"
                        Opacity="0.5" />
                </StackPanel>
            </muxc:NavigationView.PaneFooter>

            <Grid>
                <!--
                    Scrolls rather than clips. A list-and-detail page is laid out
                    for a desktop window, and at 900x700 the detail column - every
                    action on the surface - was simply unreachable. Scrolling is
                    not the nicest answer at that size, but "the actions exist and
                    you can get to them" beats "the actions are gone"
                    (AOS-R001-007).

                    The page is given the host's own size, in code-behind rather
                    than by binding: a ScrollViewer offers its content unlimited
                    space, a page with star-sized columns takes all of it, and
                    WinUI's ActualWidth raises no change notification for a binding
                    to follow. The first attempt at this repair did bind, the page
                    stayed unconstrained, and Command Center's Refresh and Complete
                    buttons then sat outside a 1600x1000 window that had room for
                    them.

                    Below the floor the page stops shrinking and the host scrolls.
                    At or above it nothing scrolls and the layout is what it always
                    was. Both axes: at 1280x720 the Sync page's "Discard selected
                    change" was below the fold with nothing to scroll.
                -->
                <ScrollViewer
                    x:Name="ContentHost"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Auto"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Auto"
                    SizeChanged="OnContentHostSizeChanged">
                    <Frame x:Name="ContentFrame" />
                </ScrollViewer>

                <!--
                    Global search. Ctrl+K, keyboard-first, and explicit about
                    whether it reached the server or fell back to the cache
                    (docs/12_WINDOWS_NATIVE.md).
                -->
                <Grid
                    x:Name="SearchLayer"
                    Visibility="Collapsed"
                    Background="{ThemeResource SystemControlPageBackgroundMediumAltMediumBrush}">

                    <Border
                        Width="640"
                        MaxHeight="520"
                        Margin="0,72,0,0"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">

                        <Grid RowSpacing="6" Padding="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBox
                                x:Name="SearchQuery"
                                Grid.Row="0"
                                PlaceholderText="Search people, companies and tasks…"
                                TextChanged="OnSearchQueryChanged"
                                KeyDown="OnSearchKeyDown" />

                            <StackPanel Grid.Row="1" Spacing="4">
                                <ProgressBar x:Name="SearchBusy"
                                             AutomationProperties.Name="Search progress" IsIndeterminate="True" Visibility="Collapsed" />

                                <InfoBar
                                    x:Name="SearchOfflineBar"
                                    Severity="Warning"
                                    IsOpen="False"
                                    IsClosable="False"
                                    Title="Showing cached results"
                                    Message="The server could not be reached. These are local matches on a possibly stale copy, not ranked results." />

                                <InfoBar
                                    x:Name="SearchEmptyBar"
                                    Severity="Informational"
                                    IsOpen="False"
                                    IsClosable="False"
                                    Title="Nothing matched" />

                                <InfoBar
                                    x:Name="SearchErrorBar"
                                    Severity="Error"
                                    IsOpen="False"
                                    IsClosable="False"
                                    Title="Search failed" />
                            </StackPanel>

                            <ListView
                                x:Name="SearchResults"
                                      AutomationProperties.Name="Search results"
                                Grid.Row="2"
                                SelectionMode="Single"
                                IsItemClickEnabled="True"
                                ItemClick="OnSearchItemClick">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="12" Padding="4,6" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Spacing="1">
                                                <TextBlock Text="{Binding Title}" />
                                                <TextBlock
                                                    Text="{Binding Subtitle}"
                                                    Opacity="0.65"
                                                    Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>

                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding Type, Converter={StaticResource DisplayLabel}}"
                                                VerticalAlignment="Center"
                                                Opacity="0.6"
                                                Style="{StaticResource CaptionTextBlockStyle}" />

                                            <!--
                                                Why it matched. A ranked list that
                                                cannot account for its own order is
                                                a number nobody can explain.
                                            -->
                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{Binding MatchedOn}"
                                                VerticalAlignment="Center"
                                                Opacity="0.45"
                                                Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Command palette. Keyboard-first, per docs/12_WINDOWS_NATIVE.md. -->
                <Grid
                    x:Name="PaletteLayer"
                    Visibility="Collapsed"
                    Background="{ThemeResource SystemControlPageBackgroundMediumAltMediumBrush}">

                    <Border
                        Width="560"
                        MaxHeight="420"
                        Margin="0,80,0,0"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">

                        <Grid RowSpacing="4" Padding="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBox
                                x:Name="PaletteQuery"
                                Grid.Row="0"
                                PlaceholderText="Type a command…"
                                TextChanged="OnPaletteQueryChanged"
                                KeyDown="OnPaletteKeyDown" />

                            <ListView
                                x:Name="PaletteResults"
                                      AutomationProperties.Name="Palette results"
                                Grid.Row="1"
                                SelectionMode="Single"
                                IsItemClickEnabled="True"
                                ItemClick="OnPaletteItemClick">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="12" Padding="4,2" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Title}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Category}" Opacity="0.6" />
                                            <TextBlock Grid.Column="2" Text="{Binding Shortcut}" Opacity="0.5" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </muxc:NavigationView>
    </Grid>
</Window>
