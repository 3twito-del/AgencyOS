<Window
    x:Class="AgencyOS.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="AgencyOS">

    <Grid>
        <muxc:NavigationView
            x:Name="Navigation"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="220"
            SelectionChanged="OnNavigationSelectionChanged">

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Command Center" Tag="command-center" AccessKey="1" />
                <muxc:NavigationViewItem Content="People" Tag="people" AccessKey="2" />
                <muxc:NavigationViewItem Content="Companies" Tag="companies" AccessKey="3" />
            </muxc:NavigationView.MenuItems>

            <muxc:NavigationView.PaneFooter>
                <StackPanel Padding="12,8" Spacing="4">
                    <TextBlock
                        x:Name="ConnectionText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap"
                        Opacity="0.7" />
                    <TextBlock
                        x:Name="BuildText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.5" />
                </StackPanel>
            </muxc:NavigationView.PaneFooter>

            <Grid>
                <Frame x:Name="ContentFrame" />

                <!-- Command palette. Keyboard-first, per docs/12_WINDOWS_NATIVE.md. -->
                <Grid
                    x:Name="PaletteLayer"
                    Visibility="Collapsed"
                    Background="{ThemeResource SystemControlPageBackgroundMediumAltMediumBrush}">

                    <Border
                        Width="560"
                        MaxHeight="420"
                        Margin="0,80,0,0"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">

                        <Grid RowSpacing="4" Padding="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBox
                                x:Name="PaletteQuery"
                                Grid.Row="0"
                                PlaceholderText="Type a command…"
                                TextChanged="OnPaletteQueryChanged"
                                KeyDown="OnPaletteKeyDown" />

                            <ListView
                                x:Name="PaletteResults"
                                Grid.Row="1"
                                SelectionMode="Single"
                                IsItemClickEnabled="True"
                                ItemClick="OnPaletteItemClick">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="12" Padding="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Title}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Category}" Opacity="0.6" />
                                            <TextBlock Grid.Column="2" Text="{Binding Shortcut}" Opacity="0.5" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </muxc:NavigationView>
    </Grid>
</Window>
