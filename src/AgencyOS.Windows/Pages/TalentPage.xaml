<Page
    x:Class="AgencyOS.Windows.Pages.TalentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid Padding="16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: the list, with the filters an agent actually works from. -->
        <Grid Grid.Column="0" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Talent" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Grid.Column="1"
                    x:Name="CountText"
                    VerticalAlignment="Center"
                    Opacity="0.6"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </Grid>

            <TextBox
                x:Name="SearchBox"
                Grid.Row="1"
                PlaceholderText="Search by name…"
                KeyDown="OnSearchKeyDown" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
                <CheckBox x:Name="ClientsOnlyBox" Content="Clients" Click="OnFilterChanged" />
                <CheckBox x:Name="FormerOnlyBox" Content="Former" Click="OnFilterChanged" />
                <ComboBox
                    x:Name="DisciplineBox" AutomationProperties.Name="Discipline"
                    PlaceholderText="Any discipline"
                    MinWidth="140"
                    SelectionChanged="OnDisciplineChanged">
                    <ComboBoxItem Content="Any discipline" Tag="" />
                    <ComboBoxItem Content="Actor" Tag="Actor" />
                    <ComboBoxItem Content="Writer" Tag="Writer" />
                    <ComboBoxItem Content="Director" Tag="Director" />
                    <ComboBoxItem Content="Producer" Tag="Producer" />
                    <ComboBoxItem Content="Showrunner" Tag="Showrunner" />
                    <ComboBoxItem Content="Creator" Tag="Creator" />
                    <ComboBoxItem Content="Composer" Tag="Composer" />
                    <ComboBoxItem Content="Author" Tag="Author" />
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="3" Spacing="6">
                <ProgressBar x:Name="ListBusy"
                             AutomationProperties.Name="List progress" IsIndeterminate="True" Visibility="Collapsed" />
                <InfoBar x:Name="ListError" Severity="Error" IsOpen="False" IsClosable="False"
                         Title="Could not load talent" />
                <InfoBar x:Name="ListEmpty" Severity="Informational" IsOpen="False" IsClosable="False"
                         Title="Nothing matches"
                         Message="No talent profile fits these filters." />
            </StackPanel>

            <ListView
                x:Name="TalentList"
                      AutomationProperties.Name="Talent"
                Grid.Row="4"
                SelectionMode="Single"
                SelectionChanged="OnTalentSelected">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="4,6" ColumnSpacing="10" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="1">
                                <TextBlock Text="{Binding DisplayName}" />
                                <TextBlock
                                    Text="{Binding CareerStage}"
                                    Opacity="0.6"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>

                            <!--
                                Representation status is the one thing an agent
                                scanning this list needs at a glance.
                            -->
                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding RepresentationStatus}"
                                VerticalAlignment="Center"
                                Opacity="0.7"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Right: the working surface, not a card dashboard. -->
        <Grid Grid.Column="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="2">
                <TextBlock x:Name="ClientName" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    x:Name="ClientStatusLine"
                    Opacity="0.75"
                    TextWrapping="Wrap"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="6">
                <InfoBar
                    x:Name="DetailEmpty"
                    Severity="Informational"
                    IsOpen="True"
                    IsClosable="False"
                    Title="Select somebody"
                    Message="Choose a talent profile to see how the agency represents them." />

                <!-- Titled by whatever was refused: a command is not a load (AOS-R002-012). -->
                <InfoBar x:Name="CommandError" Severity="Error" IsOpen="False" IsClosable="True" />

                <!--
                    The open task about this client, said as the thing to do next.
                    The tasks tab already listed it; nothing said it was next, which
                    is the question a blind handoff could not answer.
                -->
                <InfoBar x:Name="NextActionBar" Severity="Informational" IsOpen="False" IsClosable="False"
                         Title="Next action"
                         AutomationProperties.Name="Next action" />
            </StackPanel>

            <muxc:TabView
                Grid.Row="2"
                x:Name="ClientTabs"
                IsAddTabButtonVisible="False"
                CanDragTabs="False"
                CanReorderTabs="False"
                Visibility="Collapsed">

                <muxc:TabViewItem Header="Overview" IsClosable="False">
                    <ScrollViewer>
                        <StackPanel Padding="12" Spacing="10">
                            <TextBlock Text="Summary" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" />

                            <!--
                                Internal positioning appears only when the server
                                returned it. Absent and withheld look identical, so
                                the screen simply says nothing either way.
                            -->
                            <StackPanel x:Name="PositioningPanel" Spacing="2" Visibility="Collapsed">
                                <TextBlock Text="Internal positioning"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="PositioningText" TextWrapping="Wrap" Opacity="0.85" />
                            </StackPanel>

                            <TextBlock Text="Disciplines" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="DisciplinesText" TextWrapping="Wrap" Opacity="0.85" />

                            <TextBlock Text="Base market" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="MarketText" Opacity="0.85" />

                            <!--
                                Recent contact, on the tab an operator lands on.

                                The overview already carried these interactions and
                                showed none of them, so the only place in the product
                                that rendered a caller's detailed notes was the
                                org-wide Command Center. Somebody handed a name had no
                                route to them at all. The rows are the shared
                                interaction template, so the notes disclose here the
                                same way they disclose there.
                            -->
                            <TextBlock Text="Recent contact" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ListView x:Name="InteractionList"
                                      AutomationProperties.Name="Recent contact"
                                      SelectionMode="None"
                                      ItemTemplate="{StaticResource InteractionTemplate}" />
                            <TextBlock x:Name="InteractionEmpty"
                                       Text="No contact has been recorded."
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Opacity="0.7"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>
                </muxc:TabViewItem>

                <muxc:TabViewItem Header="Representation" IsClosable="False">
                    <ScrollViewer>
                        <StackPanel Padding="12" Spacing="10">
                            <InfoBar x:Name="NoRepresentationBar" Severity="Informational" IsOpen="False"
                                     IsClosable="False" Title="Not represented"
                                     Message="The agency has no representation relationship with this person." />

                            <TextBlock x:Name="RepresentationSummary" TextWrapping="Wrap" />

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Scopes"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1" x:Name="ChangeScopeButton" Content="Change scopes"
                                        Click="OnChangeScopeClick" IsEnabled="False" />
                            </Grid>
                            <ListView x:Name="ScopeList"
                                      AutomationProperties.Name="Representation scopes" SelectionMode="None" MaxHeight="220">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="4,4" ColumnSpacing="12" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Area}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding StartsOn, Converter={StaticResource IsoDate}}"
                                                Opacity="0.6"
                                                Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </ScrollViewer>
                </muxc:TabViewItem>

                <muxc:TabViewItem Header="Team" IsClosable="False">
                  <Grid Padding="12" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" x:Name="ChangeTeamButton" Content="Change team"
                            Click="OnChangeTeamClick" HorizontalAlignment="Left" IsEnabled="False" />

                    <ListView Grid.Row="1" x:Name="TeamList"
                              AutomationProperties.Name="Teams" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4,6" ColumnSpacing="12" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding Role}"
                                        Opacity="0.65"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                  </Grid>
                </muxc:TabViewItem>

                <muxc:TabViewItem Header="Credits" IsClosable="False">
                    <Grid Padding="12" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0" Content="Add credit" Click="OnAddCreditClick" HorizontalAlignment="Left" />

                        <ListView Grid.Row="1" x:Name="CreditList"
                                  AutomationProperties.Name="Credits" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4,6" ColumnSpacing="12" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="1">
                                            <TextBlock Text="{Binding Title}" />
                                            <TextBlock
                                                Text="{Binding Role}"
                                                Opacity="0.6"
                                                Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Type, Converter={StaticResource DisplayLabel}}" Opacity="0.65"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Year}" Opacity="0.5"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </muxc:TabViewItem>

                <muxc:TabViewItem Header="Materials" IsClosable="False">
                    <Grid Padding="12" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0" Content="Add material" Click="OnAddMaterialClick"
                                HorizontalAlignment="Left" />

                        <!--
                            AgencyOS holds no file content in this milestone. Saying
                            so plainly is better than a screen that looks like a
                            document store and is not one.
                        -->
                        <InfoBar
                            Grid.Row="1"
                            Severity="Informational"
                            IsOpen="True"
                            IsClosable="False"
                            Title="Metadata only"
                            Message="AgencyOS records what exists and where it lives. It does not store the file itself yet." />

                        <ListView Grid.Row="2" x:Name="MaterialList"
                                  AutomationProperties.Name="Materials" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4,6" ColumnSpacing="12" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="1">
                                            <TextBlock Text="{Binding Title}" />
                                            <TextBlock
                                                Text="{Binding VersionLabel}"
                                                Opacity="0.6"
                                                Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Type, Converter={StaticResource DisplayLabel}}" Opacity="0.65"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Status, Converter={StaticResource DisplayLabel}}" Opacity="0.5"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </muxc:TabViewItem>

                <muxc:TabViewItem Header="Activity" IsClosable="False">
                    <ListView x:Name="HistoryList"
                              AutomationProperties.Name="History" SelectionMode="None" Padding="12">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4,6" ColumnSpacing="12" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding OccurredOn}" Opacity="0.55"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}" Opacity="0.6" TextWrapping="Wrap"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </muxc:TabViewItem>

                <muxc:TabViewItem Header="Tasks" IsClosable="False">
                    <ListView x:Name="TaskList"
                              AutomationProperties.Name="Tasks" SelectionMode="None" Padding="12">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4,6" ColumnSpacing="12" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Text="{Binding Priority, Converter={StaticResource DisplayLabel}}" Opacity="0.6"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </muxc:TabViewItem>
            </muxc:TabView>
        </Grid>
    </Grid>
</Page>
