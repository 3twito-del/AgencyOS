<Page
    x:Class="AgencyOS.Windows.Pages.DealsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Deals" Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="StatusBox"
                          AutomationProperties.Name="Status" MinWidth="140" SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="Negotiating" Tag="Negotiating" IsSelected="True" />
                    <ComboBoxItem Content="Any status" Tag="" />
                    <ComboBoxItem Content="Draft" Tag="Draft" />
                    <ComboBoxItem Content="Terms agreed" Tag="TermsAgreed" />
                    <ComboBoxItem Content="No deal" Tag="NoDeal" />
                    <ComboBoxItem Content="Cancelled" Tag="Cancelled" />
                </ComboBox>

                <ComboBox x:Name="KindBox" AutomationProperties.Name="Deal kind" PlaceholderText="Any kind" MinWidth="170"
                          SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="Any kind" Tag="" />
                    <ComboBoxItem Content="Talent employment" Tag="TalentEmployment" />
                    <ComboBoxItem Content="Writing" Tag="Writing" />
                    <ComboBoxItem Content="Directing" Tag="Directing" />
                    <ComboBoxItem Content="Producing" Tag="Producing" />
                    <ComboBoxItem Content="Project sale" Tag="ProjectSale" />
                    <ComboBoxItem Content="Project licence" Tag="ProjectLicense" />
                    <ComboBoxItem Content="Package" Tag="Package" />
                    <ComboBoxItem Content="Services" Tag="Services" />
                    <ComboBoxItem Content="Partnership" Tag="Partnership" />
                    <ComboBoxItem Content="Other" Tag="Other" />
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="2" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <CheckBox x:Name="AwaitingBox" Content="Awaiting an answer" Click="OnFilterChanged" />
                    <CheckBox x:Name="TermsAgreedBox" Content="Terms agreed" Click="OnFilterChanged" />
                </StackPanel>

                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Name, reference or summary"
                                QuerySubmitted="OnSearchSubmitted" />
                <ProgressBar x:Name="ListBusy"
                             AutomationProperties.Name="List progress" IsIndeterminate="True" Visibility="Collapsed" />
                <InfoBar x:Name="ListError" Severity="Error" IsOpen="False" IsClosable="False"
                         Title="Could not load deals" />
                <InfoBar x:Name="ListEmpty" Severity="Informational" IsOpen="False" IsClosable="False"
                         Title="Nothing here"
                         Message="No negotiations match these filters." />
                <TextBlock x:Name="SummaryText" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>

            <ListView Grid.Row="3" x:Name="DealList"
                      AutomationProperties.Name="Deals" SelectionMode="Single"
                      SelectionChanged="OnDealSelected">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="4,6" ColumnSpacing="10" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding CounterpartyDisplayName}" Opacity="0.7"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Status, Converter={StaticResource DisplayLabel}}" Opacity="0.7"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Text="{Binding Kind, Converter={StaticResource DisplayLabel}}" Opacity="0.5"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Column="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock x:Name="DetailTitle" Style="{StaticResource SubtitleTextBlockStyle}"
                           Text="Select a deal" />
                <TextBlock x:Name="DetailStanding" Opacity="0.75"
                           Style="{StaticResource CaptionTextBlockStyle}" />

                <!--
                    Terms agreed is a commercial fact and nothing more. The wording
                    here never says signed, executed or closed, because M7 has no
                    way to know whether any contract exists (ADR-0021).
                -->
                <InfoBar x:Name="TermsAgreedBar" Severity="Success" IsOpen="False" IsClosable="False"
                         Title="Commercial terms agreed"
                         Message="This records that the parties agreed terms. No contract has been drafted, signed or executed, and AgencyOS does not track that yet." />

                <TextBlock x:Name="StrategyText" TextWrapping="Wrap" Opacity="0.85"
                           Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="8">
                <InfoBar x:Name="DetailBar" Severity="Error" IsOpen="False" IsClosable="True" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="NewButton" Content="New deal" Click="OnNewClick" />
                    <Button x:Name="InboundButton" Content="Record inbound offer"
                            Click="OnRecordInboundClick" IsEnabled="False" />
                    <Button x:Name="OutboundButton" Content="Record outbound offer"
                            Click="OnRecordOutboundClick" IsEnabled="False" />
                    <Button x:Name="AnswerButton" Content="Record response"
                            Click="OnAnswerClick" IsEnabled="False" />
                    <Button x:Name="CompareButton" Content="Compare offers"
                            Click="OnCompareClick" IsEnabled="False" />
                </StackPanel>
            </StackPanel>

            <TabView Grid.Row="2" x:Name="DetailTabs" IsAddTabButtonVisible="False"
                     CanDragTabs="False" CanReorderTabs="False">
                <TabViewItem Header="Negotiation" IsClosable="False">
                    <ScrollViewer>
                        <StackPanel Spacing="8" Padding="4">
                            <!--
                                Says what AgencyOS does and does not do, permanently.
                                The same statement the M6 submissions surface carries.
                            -->
                            <InfoBar Severity="Informational" IsOpen="True" IsClosable="False"
                                     Title="Recorded, not sent"
                                     Message="AgencyOS records that an offer was made or received. It does not send anything and cannot confirm delivery." />

                            <ListView x:Name="OfferList"
                                      AutomationProperties.Name="Offers" SelectionMode="Single"
                                      SelectionChanged="OnOfferSelected">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="4,6" ColumnSpacing="10" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Sequence}"
                                                       Opacity="0.5" VerticalAlignment="Center"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Direction, Converter={StaticResource DisplayLabel}}" />
                                                <TextBlock Text="{Binding Summary}" Opacity="0.7"
                                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding Status, Converter={StaticResource DisplayLabel}}"
                                                       Opacity="0.7" VerticalAlignment="Center"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <TabViewItem Header="Terms" IsClosable="False">
                    <ScrollViewer>
                        <StackPanel Spacing="8" Padding="4">
                            <TextBlock x:Name="TermsCaption" Opacity="0.7"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Text="Select an offer to see its terms." />
                            <ListView x:Name="TermList"
                                      AutomationProperties.Name="Terms" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="4,6" ColumnSpacing="10" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding DisplayName}" />
                                                <TextBlock Text="{Binding Notes}" Opacity="0.6"
                                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding DisplayValue}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <TabViewItem Header="Comparison" IsClosable="False">
                    <ScrollViewer>
                        <StackPanel Spacing="8" Padding="4">
                            <InfoBar x:Name="ComparisonBar" Severity="Informational" IsOpen="False"
                                     IsClosable="False" />
                            <TextBlock x:Name="ComparisonCaption" Opacity="0.7"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Text="Compare offers to see what changed." />

                            <Grid ColumnSpacing="10" Padding="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Term" Opacity="0.6"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="1" Text="Previous" Opacity="0.6"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="2" Text="Current" Opacity="0.6"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="3" Text="Change" Opacity="0.6"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </Grid>

                            <ListView x:Name="ComparisonList"
                                      AutomationProperties.Name="Version comparison" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="4,6" ColumnSpacing="10" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Previous.DisplayValue}"
                                                       Opacity="0.7" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Current.DisplayValue}" />
                                            <TextBlock Grid.Column="3" Text="{Binding Change}"
                                                       Opacity="0.7"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <TabViewItem Header="Tasks" IsClosable="False">
                    <ScrollViewer>
                        <ListView x:Name="TaskList"
                                  AutomationProperties.Name="Tasks" SelectionMode="None" Padding="4">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="4,6" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}}">
                                        <TextBlock Text="{Binding Title}" />
                                        <TextBlock Text="{Binding Priority, Converter={StaticResource DisplayLabel}}" Opacity="0.7"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </ScrollViewer>
                </TabViewItem>

                <TabViewItem Header="Activity" IsClosable="False">
                    <ScrollViewer>
                        <ListView x:Name="HistoryList"
                                  AutomationProperties.Name="History" SelectionMode="None" Padding="4">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="4,6" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}}">
                                        <TextBlock Text="{Binding Summary}" />
                                        <TextBlock Text="{Binding Detail}" Opacity="0.7"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </ScrollViewer>
                </TabViewItem>
            </TabView>
        </Grid>
    </Grid>
</Page>
