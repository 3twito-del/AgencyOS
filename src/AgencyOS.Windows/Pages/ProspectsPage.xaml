<Page
    x:Class="AgencyOS.Windows.Pages.ProspectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Prospects" Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
                <CheckBox x:Name="OpenOnlyBox" Content="Open only" IsChecked="True" Click="OnFilterChanged" />
                <ComboBox x:Name="StageBox" PlaceholderText="Any stage" MinWidth="150"
                          SelectionChanged="OnStageChanged">
                    <ComboBoxItem Content="Any stage" Tag="" />
                    <ComboBoxItem Content="Identified" Tag="Identified" />
                    <ComboBoxItem Content="Contacted" Tag="Contacted" />
                    <ComboBoxItem Content="Courting" Tag="Courting" />
                    <ComboBoxItem Content="Declined" Tag="Declined" />
                    <ComboBoxItem Content="Lost" Tag="Lost" />
                    <ComboBoxItem Content="Converted" Tag="Converted" />
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="2" Spacing="6">
                <ProgressBar x:Name="ListBusy"
                             AutomationProperties.Name="List progress" IsIndeterminate="True" Visibility="Collapsed" />
                <InfoBar x:Name="ListError" Severity="Error" IsOpen="False" IsClosable="False"
                         Title="Could not load prospects" />
                <InfoBar x:Name="ListEmpty" Severity="Informational" IsOpen="False" IsClosable="False"
                         Title="No prospects"
                         Message="Nobody is currently being pursued under these filters." />
            </StackPanel>

            <ListView Grid.Row="3" x:Name="ProspectList"
                      AutomationProperties.Name="Prospects" SelectionMode="Single"
                      SelectionChanged="OnProspectSelected">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="4,6" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="1">
                                <TextBlock Text="{Binding DisplayName}" />
                                <TextBlock Text="{Binding OwnerDisplayName}" Opacity="0.6"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Stage}" VerticalAlignment="Center"
                                       Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="12">
                <TextBlock x:Name="ProspectName" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="ProspectLine" Opacity="0.75" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}" />

                <InfoBar x:Name="DetailEmpty" Severity="Informational" IsOpen="True" IsClosable="False"
                         Title="Select a prospect"
                         Message="Choose somebody to see where the pursuit stands and what to do next." />

                <InfoBar x:Name="ClosedBar" Severity="Informational" IsOpen="False" IsClosable="False"
                         Title="This pursuit is closed"
                         Message="Pursuing them again would be a new prospect, which is what actually happened." />

                <StackPanel x:Name="StrategyPanel" Spacing="2" Visibility="Collapsed">
                    <TextBlock Text="Strategy" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="StrategyText" TextWrapping="Wrap" Opacity="0.85" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ContactedButton" Content="Mark contacted" Click="OnContactedClick" />
                    <Button x:Name="CourtingButton" Content="Mark courting" Click="OnCourtingClick" />
                    <Button x:Name="DeclinedButton" Content="Declined" Click="OnDeclinedClick" />
                    <Button x:Name="ConvertButton" Content="Convert to client…" Click="OnConvertClick"
                            Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>

                <Button Content="Refresh" Click="OnRefreshClick" HorizontalAlignment="Left" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
