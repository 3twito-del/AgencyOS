<Page
    x:Class="AgencyOS.Windows.Pages.CommandCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header and counts -->
        <Grid Grid.Row="0" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Command Center" Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="OpenTasksText" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="open tasks" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="PeopleCountText" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="people" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="CompanyCountText" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="companies" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                </StackPanel>
                <Button x:Name="RefreshButton" Content="Refresh" Click="OnRefreshClick" />
            </StackPanel>
        </Grid>

        <!-- Loading / error / empty -->
        <StackPanel Grid.Row="1" Spacing="8">
            <ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed" />

            <InfoBar
                x:Name="ErrorBar"
                Severity="Error"
                IsOpen="False"
                IsClosable="False"
                Title="Could not load the Command Center" />

            <InfoBar
                x:Name="EmptyBar"
                Severity="Informational"
                IsOpen="False"
                IsClosable="False"
                Title="Nothing needs attention"
                Message="No open tasks and no recorded interactions yet." />
        </StackPanel>

        <!-- Dense operational lists -->
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Text="Overdue" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                <ListView x:Name="OverdueList" SelectionMode="Single" ItemTemplate="{StaticResource TaskTemplate}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="Due soon" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ListView x:Name="DueSoonList" SelectionMode="Single" ItemTemplate="{StaticResource TaskTemplate}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Text="Unscheduled" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ListView x:Name="UnscheduledList" SelectionMode="Single" ItemTemplate="{StaticResource TaskTemplate}" />
            </StackPanel>

            <StackPanel Grid.Column="3" Spacing="6">
                <Grid>
                    <TextBlock Text="Recent interactions" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Button
                        Content="Complete selected task"
                        HorizontalAlignment="Right"
                        Click="OnCompleteClick" />
                </Grid>
                <ListView x:Name="RecentList" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="4,3">
                                <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Opacity="0.6"
                                    Text="{Binding Type}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
