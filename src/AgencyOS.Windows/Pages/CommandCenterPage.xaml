<Page
    x:Class="AgencyOS.Windows.Pages.CommandCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header and counts -->
        <Grid Grid.Row="0" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Command Center" Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="OpenTasksText" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <!--
                        "in total" because the lists below are windows onto this
                        number and not a rendering of it. Without those two words
                        the headline and the rows read as one population, and an
                        operator who scanned the rows believed they had seen the
                        work (F-05).
                    -->
                    <TextBlock Text="open tasks in total" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="PeopleCountText" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="people" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="CompanyCountText" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="companies" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
                </StackPanel>
                <Button x:Name="RefreshButton" Content="Refresh" Click="OnRefreshClick" />
            </StackPanel>
        </Grid>

        <!-- Loading / error / empty -->
        <StackPanel Grid.Row="1" Spacing="8">
            <ProgressBar x:Name="Busy"
                         AutomationProperties.Name="Working" IsIndeterminate="True" Visibility="Collapsed" />

            <InfoBar
                x:Name="ErrorBar"
                Severity="Error"
                IsOpen="False"
                IsClosable="False"
                Title="Could not load the Command Center" />

            <InfoBar
                x:Name="EmptyBar"
                Severity="Informational"
                IsOpen="False"
                IsClosable="False"
                Title="Nothing needs attention"
                Message="No open tasks and no recorded interactions yet." />

            <!--
                What the three lists beneath this are, and where the rest of the
                open tasks went. The headline counts every open task in the
                agency; the lists are the overdue, the due-soon and the undated
                windows, and an open task due further ahead than the horizon sits
                in none of them. Nothing said so, so 46 above 22 rows read as a
                contradiction or as a complete picture, and the build-82 blind
                operator took it for the latter (F-05).
            -->
            <StackPanel Spacing="2">
                <TextBlock Text="Needing attention" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="ScopeText" Opacity="0.7" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </StackPanel>

        <!-- Dense operational lists -->
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Text="Overdue" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                <ListView x:Name="OverdueList"
                          AutomationProperties.Name="Overdue" SelectionMode="Single" ItemTemplate="{StaticResource TaskTemplate}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="Due soon" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ListView x:Name="DueSoonList"
                          AutomationProperties.Name="Due soon" SelectionMode="Single" ItemTemplate="{StaticResource TaskTemplate}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Text="Unscheduled" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ListView x:Name="UnscheduledList"
                          AutomationProperties.Name="Unscheduled" SelectionMode="Single" ItemTemplate="{StaticResource TaskTemplate}" />
            </StackPanel>

            <StackPanel Grid.Column="3" Spacing="6">
                <Grid>
                    <TextBlock Text="Recent interactions" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Button
                        Content="Complete selected task"
                        HorizontalAlignment="Right"
                        Click="OnCompleteClick" />
                </Grid>
                <ListView x:Name="RecentList"
                          AutomationProperties.Name="Recent interactions" SelectionMode="None"
                          ItemTemplate="{StaticResource InteractionTemplate}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
