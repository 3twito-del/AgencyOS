<Page
    x:Class="AgencyOS.Windows.Pages.PipelinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="440" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Pipeline" Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="StatusBox"
                          AutomationProperties.Name="Status" MinWidth="130" SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="Active" Tag="Active" IsSelected="True" />
                    <ComboBoxItem Content="Any status" Tag="" />
                    <ComboBoxItem Content="Draft" Tag="Draft" />
                    <ComboBoxItem Content="Paused" Tag="Paused" />
                    <ComboBoxItem Content="Closed" Tag="Closed" />
                    <ComboBoxItem Content="Cancelled" Tag="Cancelled" />
                </ComboBox>

                <ComboBox x:Name="KindBox" AutomationProperties.Name="Opportunity kind" PlaceholderText="Any kind" MinWidth="160"
                          SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="Any kind" Tag="" />
                    <ComboBoxItem Content="Talent engagement" Tag="TalentEngagement" />
                    <ComboBoxItem Content="Project market" Tag="ProjectMarket" />
                    <ComboBoxItem Content="Package market" Tag="PackageMarket" />
                    <ComboBoxItem Content="Staffing" Tag="Staffing" />
                    <ComboBoxItem Content="Partnership" Tag="Partnership" />
                    <ComboBoxItem Content="Other" Tag="Other" />
                </ComboBox>

                <CheckBox x:Name="AwaitingBox" Content="Awaiting a reply" Click="OnFilterChanged" />
            </StackPanel>

            <StackPanel Grid.Row="2" Spacing="6">
                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Name or description"
                                QuerySubmitted="OnSearchSubmitted" />
                <ProgressBar x:Name="ListBusy"
                             AutomationProperties.Name="List progress" IsIndeterminate="True" Visibility="Collapsed" />
                <InfoBar x:Name="ListError" Severity="Error" IsOpen="False" IsClosable="False"
                         Title="Could not load the pipeline" />
                <InfoBar x:Name="ListEmpty" Severity="Informational" IsOpen="False" IsClosable="False"
                         Title="Nothing here"
                         Message="No pursuits match these filters." />
                <TextBlock x:Name="SummaryText" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>

            <ListView Grid.Row="3" x:Name="OpportunityList"
                      AutomationProperties.Name="Opportunities" SelectionMode="Single"
                      SelectionChanged="OnOpportunitySelected">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="4,6" ColumnSpacing="10" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding Kind, Converter={StaticResource DisplayLabel}}" Opacity="0.7"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding Status, Converter={StaticResource DisplayLabel}}" Opacity="0.7"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Column="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock x:Name="DetailTitle" Style="{StaticResource SubtitleTextBlockStyle}"
                           Text="Select an opportunity" />
                <TextBlock x:Name="DetailStanding" Opacity="0.75"
                           Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock x:Name="StrategyText" TextWrapping="Wrap" Opacity="0.85"
                           Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="8">
                <InfoBar x:Name="DetailBar" Severity="Error" IsOpen="False" IsClosable="True" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="NewButton" Content="New opportunity" Click="OnNewClick" />
                    <Button x:Name="AddTargetButton" Content="Add target" Click="OnAddTargetClick"
                            IsEnabled="False" />
                    <Button x:Name="SubmissionButton" Content="Record submission"
                            Click="OnRecordSubmissionClick" IsEnabled="False" />
                    <Button x:Name="PitchButton" Content="Record pitch" Click="OnRecordPitchClick"
                            IsEnabled="False" />
                    <Button x:Name="StageButton" Content="Move target" Click="OnMoveTargetClick"
                            IsEnabled="False" />
                </StackPanel>
            </StackPanel>

            <TabView Grid.Row="2" x:Name="DetailTabs" IsAddTabButtonVisible="False"
                     CanDragTabs="False" CanReorderTabs="False">
                <TabViewItem Header="Targets" IsClosable="False">
                    <ScrollViewer>
                        <StackPanel Spacing="8" Padding="4">
                            <InfoBar x:Name="OverdueBar" Severity="Warning" IsOpen="False"
                                     IsClosable="False" Title="Action overdue" />
                            <ListView x:Name="TargetList"
                                      AutomationProperties.Name="Targets" SelectionMode="Single"
                                      SelectionChanged="OnTargetSelected">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="4,6" ColumnSpacing="10" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding DisplayName}" />

                                                <!--
                                                    The contact was here as a bare name. A target
                                                    carries three identities - the party approached,
                                                    the individual dealt with there, and the internal
                                                    member responsible - and nothing said which this
                                                    one was.
                                                -->
                                                <TextBlock Text="{Binding Converter={StaticResource TargetContact}}"
                                                           Opacity="0.7"
                                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding Stage, Converter={StaticResource DisplayLabel}}"
                                                       Opacity="0.7"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <TabViewItem Header="Submissions" IsClosable="False">
                    <ScrollViewer>
                        <StackPanel Spacing="8" Padding="4">
                            <InfoBar Severity="Informational" IsOpen="True" IsClosable="False"
                                     Title="Recorded, not sent"
                                     Message="AgencyOS records that a submission happened. It does not send anything and cannot confirm delivery." />
                            <ListView x:Name="SubmissionList"
                                      AutomationProperties.Name="Submissions" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="4,6" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}}">
                                            <TextBlock Text="{Binding TargetDisplayName}" />
                                            <TextBlock Text="{Binding Subject}" Opacity="0.7"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </ScrollViewer>
                </TabViewItem>

                <TabViewItem Header="Pitches" IsClosable="False">
                    <!--
                        The list scrolls itself. Wrapped in a ScrollViewer as well, an empty
                        list with padding alternated between two heights on every layout pass
                        until WinUI stopped with a layout cycle, which ends the process
                        (AOS-R002-022).
                    -->
                    <ListView x:Name="PitchList"
                              AutomationProperties.Name="Pitches" SelectionMode="None" Padding="4">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="4,6" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}}">
                                    <TextBlock Text="{Binding TargetDisplayName}" />
                                    <TextBlock Text="{Binding Outcome, Converter={StaticResource DisplayLabel}}" Opacity="0.7"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </TabViewItem>

                <TabViewItem Header="Subjects" IsClosable="False">
                    <ListView x:Name="SubjectList"
                              AutomationProperties.Name="Subjects" SelectionMode="None" Padding="4">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="4,6" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}}">
                                    <TextBlock Text="{Binding DisplayName}" />
                                    <TextBlock Text="{Binding Detail}" Opacity="0.7"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </TabViewItem>

                <TabViewItem Header="Tasks" IsClosable="False">
                    <ListView x:Name="TaskList"
                              AutomationProperties.Name="Tasks" SelectionMode="None" Padding="4">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="4,6" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}}">
                                    <TextBlock Text="{Binding Title}" />
                                    <TextBlock Text="{Binding Priority, Converter={StaticResource DisplayLabel}}" Opacity="0.7"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock Text="{Binding Converter={StaticResource TaskWho}}" Opacity="0.7"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock Text="{Binding Converter={StaticResource TaskWhen}}" Opacity="0.7"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </TabViewItem>

                <TabViewItem Header="Activity" IsClosable="False">
                    <ListView x:Name="HistoryList"
                              AutomationProperties.Name="History" SelectionMode="None" Padding="4">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="4,6" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}}">
                                    <TextBlock Text="{Binding Summary}" />
                                    <TextBlock Text="{Binding TargetDisplayName}" Opacity="0.7"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </TabViewItem>
            </TabView>
        </Grid>
    </Grid>
</Page>
