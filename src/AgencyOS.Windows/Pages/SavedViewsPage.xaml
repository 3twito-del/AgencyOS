<Page
    x:Class="AgencyOS.Windows.Pages.SavedViewsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Saved Views" Style="{StaticResource TitleTextBlockStyle}" />
                <Button Grid.Column="1" Content="New" Click="OnNewClick" />
            </Grid>

            <StackPanel Grid.Row="1" Spacing="6">
                <ProgressBar x:Name="ListBusy"
                             AutomationProperties.Name="List progress" IsIndeterminate="True" Visibility="Collapsed" />
                <InfoBar x:Name="ListError" Severity="Error" IsOpen="False" IsClosable="False"
                         Title="Could not load saved views" />
                <InfoBar x:Name="ListEmpty" Severity="Informational" IsOpen="False" IsClosable="False"
                         Title="No saved views yet"
                         Message="A saved view is a named filter over people, companies or tasks. It is yours alone." />
            </StackPanel>

            <ListView
                x:Name="ViewList"
                      AutomationProperties.Name="Saved views"
                Grid.Row="2"
                SelectionMode="Single"
                SelectionChanged="OnViewSelected">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="4,6" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}}">
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Text="{Binding Target}" Opacity="0.6"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Column="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="8">
                <TextBlock Text="Definition" Style="{StaticResource SubtitleTextBlockStyle}" />

                <InfoBar x:Name="DetailEmpty" Severity="Informational" IsOpen="True" IsClosable="False"
                         Title="Select a view"
                         Message="Choose a saved view to edit it, or create one from the current filters." />

                <InfoBar x:Name="ConflictBar" Severity="Warning" IsOpen="False" IsClosable="False"
                         Title="This view changed elsewhere"
                         Message="Reload it before saving, so you do not overwrite the newer definition." />
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="8">
                <TextBox x:Name="NameBox" Header="Name" PlaceholderText="Priority contacts" />

                <ComboBox x:Name="TargetBox" Header="Lists" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="People" Tag="People" />
                    <ComboBoxItem Content="Companies" Tag="Companies" />
                    <ComboBoxItem Content="Tasks" Tag="Tasks" />
                </ComboBox>

                <TextBox x:Name="TextContainsBox" Header="Name contains" />
                <TextBox x:Name="TitleContainsBox" Header="Title contains" />

                <ComboBox x:Name="StatusBox" Header="Status" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Any" Tag="" />
                    <ComboBoxItem Content="Active" Tag="Active" />
                    <ComboBoxItem Content="Archived" Tag="Archived" />
                </ComboBox>

                <CheckBox x:Name="OverdueOnlyBox" Content="Overdue tasks only" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="SaveButton" Content="Save" Click="OnSaveClick" Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="RunButton" Content="Run" Click="OnRunClick" />
                <Button x:Name="DeleteButton" Content="Delete" Click="OnDeleteClick" />
                <Button Content="Refresh" Click="OnRefreshClick" />
            </StackPanel>

            <Grid Grid.Row="3" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Results" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <InfoBar
                    Grid.Row="1"
                    x:Name="NoResultsBar"
                    Severity="Informational"
                    IsOpen="False"
                    IsClosable="False"
                    Title="Nothing matched"
                    Message="This view is correct; there is simply nothing that fits it right now." />

                <ListView Grid.Row="2" x:Name="ResultList"
                          AutomationProperties.Name="Results" SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4,6" ColumnSpacing="12" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="1">
                                    <TextBlock Text="{Binding Title}" />
                                    <TextBlock
                                        Text="{Binding Subtitle}"
                                        Opacity="0.65"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding Kind, Converter={StaticResource DisplayLabel}}"
                                    VerticalAlignment="Center"
                                    Opacity="0.55"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    Grid.Row="3"
                    x:Name="VersionText"
                    Opacity="0.6"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
