<Page
    x:Class="AgencyOS.Windows.Pages.DocumentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="470" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="Documents" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Opacity="0.7" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Text="Files AgencyOS holds, with every version kept. Updating a document adds a version; nothing replaces one." />
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="KindBox"
                          AutomationProperties.Name="Kind" MinWidth="160" SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="Any kind" Tag="" IsSelected="True" />
                    <ComboBoxItem Content="Contract" Tag="Contract" />
                    <ComboBoxItem Content="Contract draft" Tag="ContractDraft" />
                    <ComboBoxItem Content="Side letter" Tag="SideLetter" />
                    <ComboBoxItem Content="Amendment" Tag="Amendment" />
                    <ComboBoxItem Content="Deal memo" Tag="DealMemo" />
                    <ComboBoxItem Content="Script" Tag="Script" />
                    <ComboBoxItem Content="Treatment" Tag="Treatment" />
                    <ComboBoxItem Content="Pitch deck" Tag="PitchDeck" />
                    <ComboBoxItem Content="Headshot" Tag="Headshot" />
                    <ComboBoxItem Content="Resume" Tag="Resume" />
                    <ComboBoxItem Content="Bio" Tag="Bio" />
                    <ComboBoxItem Content="Reel" Tag="Reel" />
                    <ComboBoxItem Content="Invoice" Tag="Invoice" />
                    <ComboBoxItem Content="Remittance" Tag="Remittance" />
                    <ComboBoxItem Content="Statement" Tag="Statement" />
                    <ComboBoxItem Content="Email attachment" Tag="CorrespondenceAttachment" />
                    <ComboBoxItem Content="Other" Tag="Other" />
                </ComboBox>

                <ComboBox x:Name="SensitivityBox"
                          AutomationProperties.Name="Sensitivity" MinWidth="150" SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="Any sensitivity" Tag="" IsSelected="True" />
                    <ComboBoxItem Content="Internal" Tag="Internal" />
                    <ComboBoxItem Content="Confidential" Tag="Confidential" />
                    <ComboBoxItem Content="Privileged" Tag="Privileged" />
                    <ComboBoxItem Content="Financial" Tag="Financial" />
                    <ComboBoxItem Content="Restricted" Tag="Restricted" />
                </ComboBox>

                <ComboBox x:Name="StatusBox"
                          AutomationProperties.Name="Status" MinWidth="130" SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="Active" Tag="Active" IsSelected="True" />
                    <ComboBoxItem Content="Archived" Tag="Archived" />
                    <ComboBoxItem Content="Both" Tag="" />
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="2" Spacing="6">
                <CheckBox x:Name="HasContentBox" Content="Only where the file is held"
                          Click="OnFilterChanged" />

                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Title or reference"
                                QuerySubmitted="OnSearchSubmitted" />

                <!--
                    Said on the screen, because a user who assumes otherwise will
                    conclude a contract is missing when it is merely not findable
                    by a phrase inside it. Full-content search is deferred, and
                    getting the authorization right comes first (ADR-0025).
                -->
                <TextBlock x:Name="SearchScopeText" Opacity="0.6" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}" />

                <ProgressBar x:Name="ListBusy"
                             AutomationProperties.Name="List progress" IsIndeterminate="True" Visibility="Collapsed" />
                <InfoBar x:Name="ListError" Severity="Error" IsOpen="False" IsClosable="False"
                         Title="Could not load documents" />
                <InfoBar x:Name="ListEmpty" Severity="Informational" IsOpen="False"
                         IsClosable="False" Title="Nothing here"
                         Message="No documents match these filters." />
                <TextBlock x:Name="SummaryText" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>

            <ListView Grid.Row="3" x:Name="DocumentList"
                      AutomationProperties.Name="Documents" SelectionMode="Single"
                      SelectionChanged="OnDocumentSelected">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="4,6" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Title}" />
                                <TextBlock Text="{Binding Kind}" Opacity="0.7"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Sensitivity}" Opacity="0.7"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Text="{Binding Status}" Opacity="0.5"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Column="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock x:Name="DetailTitle" Style="{StaticResource SubtitleTextBlockStyle}"
                           Text="Select a document" />
                <TextBlock x:Name="DetailStanding" Opacity="0.75"
                           Style="{StaticResource CaptionTextBlockStyle}" />

                <!--
                    Recorded is when AgencyOS was handed the file. It is not when
                    the document was written, and the two are labelled apart so a
                    March contract that arrived in July is not read as a July
                    contract (ADR-0024).
                -->
                <TextBlock x:Name="DetailDates" Opacity="0.6" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="6">
                <ProgressBar x:Name="DetailBusy"
                             AutomationProperties.Name="Detail progress" IsIndeterminate="True" Visibility="Collapsed" />

                <InfoBar x:Name="DetailBar" Severity="Error" IsOpen="False" IsClosable="False"
                         Title="That did not happen" />

                <InfoBar x:Name="ScanBar" Severity="Warning" IsOpen="False" IsClosable="False"
                         Title="Nothing scanned this file" />

                <InfoBar x:Name="ArchivedBar" Severity="Informational" IsOpen="False"
                         IsClosable="False" Title="Archived"
                         Message="This document is out of ordinary use. Nothing was deleted: every version and every byte is still here." />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="RecordButton" Content="Record document" Click="OnRecordDocument" />
                    <Button x:Name="AddVersionButton" Content="Add version" Click="OnAddVersion"
                            IsEnabled="False" />
                    <Button x:Name="DownloadButton" Content="Download" Click="OnDownload"
                            IsEnabled="False" />
                    <Button x:Name="LinkButton" Content="Link" Click="OnLink" IsEnabled="False" />
                    <Button x:Name="ArchiveButton" Content="Archive" Click="OnArchive"
                            IsEnabled="False" />
                    <Button x:Name="RestoreButton" Content="Restore" Click="OnRestore"
                            IsEnabled="False" />
                </StackPanel>
            </StackPanel>

            <TabView Grid.Row="2" x:Name="DetailTabs" IsAddTabButtonVisible="False"
                     CanDragTabs="False" CanReorderTabs="False">

                <TabViewItem Header="Versions" IsClosable="False">
                    <Grid RowSpacing="6" Padding="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Opacity="0.6" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Text="Newest first. Every version stays readable: adding one never replaces the bytes of another." />

                        <ListView Grid.Row="1" x:Name="VersionList"
                                  AutomationProperties.Name="Versions" SelectionMode="Single"
                                  SelectionChanged="OnVersionSelected">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Sequence}"
                                                   VerticalAlignment="Center" Opacity="0.6" />

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DisplayFileName}" />
                                            <TextBlock Text="{Binding MediaType}" Opacity="0.6"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding RecordedAt}" Opacity="0.7"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock Text="{Binding ContentHash}" Opacity="0.4"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="220"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </TabViewItem>

                <TabViewItem Header="Links" IsClosable="False">
                    <Grid RowSpacing="6" Padding="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <InfoBar Grid.Row="0" Severity="Informational" IsOpen="True"
                                 IsClosable="False" Title="A link is context, not access"
                                 Message="Being able to read a linked deal grants nothing about this document. Its own sensitivity decides who may open it." />

                        <ListView Grid.Row="1" x:Name="LinkList"
                                  AutomationProperties.Name="Links" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="4,6">
                                        <TextBlock Text="{Binding TargetLabel}" />
                                        <TextBlock Text="{Binding Target}" Opacity="0.6"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Button Grid.Row="2" x:Name="UnlinkButton" Content="Remove selected link"
                                Click="OnUnlink" />
                    </Grid>
                </TabViewItem>

                <TabViewItem Header="Extracted text" IsClosable="False">
                    <Grid RowSpacing="6" Padding="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--
                            A derived reading aid. The stored file is the document,
                            and text pulled out of it can be wrong about order,
                            layout and anything a legal argument would rest on
                            (ADR-0025).
                        -->
                        <InfoBar Grid.Row="0" x:Name="ExtractionBar" Severity="Informational"
                                 IsOpen="True" IsClosable="False"
                                 Title="Derived, not canonical" />

                        <TextBox Grid.Row="1" x:Name="ExtractedTextBox"
                                 AutomationProperties.Name="Extracted text" IsReadOnly="True"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </TabViewItem>

                <TabViewItem Header="History" IsClosable="False">
                    <ListView x:Name="HistoryList"
                              AutomationProperties.Name="History" Padding="0,10,0,0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding OccurredAt}"
                                               Opacity="0.6"
                                               Style="{StaticResource CaptionTextBlockStyle}" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ActorDisplayName}" Opacity="0.6"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </TabViewItem>
            </TabView>
        </Grid>
    </Grid>
</Page>
