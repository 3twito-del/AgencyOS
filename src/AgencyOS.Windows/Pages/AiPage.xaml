<Page
    x:Class="AgencyOS.Windows.Pages.AiPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="AI" Style="{StaticResource TitleTextBlockStyle}" />

            <!--
                The sentence the whole milestone rests on. A model reads what you
                may read, drafts, and proposes; it changes nothing without you.
            -->
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Text="A model reads only what you are permitted to read, and changes nothing on its own. Anything that would change AgencyOS is proposed to you first and runs only after you approve it." />

            <TextBlock x:Name="SummaryText" Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="6">
            <ProgressBar x:Name="Busy"
                         AutomationProperties.Name="Working" IsIndeterminate="True" Visibility="Collapsed" />

            <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="False"
                     Title="That did not happen" />

            <!--
                Kept visible while anything waits. An approval expires, and a person
                who never noticed it would find a task simply undone.
            -->
            <InfoBar x:Name="ApprovalBar" Severity="Warning" IsOpen="False" IsClosable="False"
                     Title="Waiting for your decision" />
        </StackPanel>

        <TabView Grid.Row="2" x:Name="Tabs" IsAddTabButtonVisible="False"
                 CanDragTabs="False" CanReorderTabs="False">

            <TabViewItem Header="Ask" IsClosable="False">
                <Grid ColumnSpacing="16" Padding="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="8">
                        <ComboBox x:Name="AgentBox" MinWidth="380" Header="Task"
                                  SelectionChanged="OnAgentChanged" />

                        <TextBlock x:Name="AgentDescription" Opacity="0.7" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}" />

                        <TextBox x:Name="TaskBox" Header="What do you want?"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="120"
                                 PlaceholderText="Describe the brief in your own words."
                                 TextChanged="OnTaskChanged" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="SubjectKindBox" MinWidth="150" Header="About"
                                      SelectionChanged="OnSubjectKindChanged" />

                            <TextBox x:Name="SubjectIdBox" MinWidth="220" Header="Record id"
                                     PlaceholderText="Optional" TextChanged="OnSubjectIdChanged" />
                        </StackPanel>

                        <ComboBox x:Name="ModelBox" MinWidth="380" Header="Model"
                                  PlaceholderText="Configured default" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="StartButton" Content="Start" Click="OnStart"
                                    Style="{StaticResource AccentButtonStyle}" />

                            <Button x:Name="CancelButton" Content="Stop this run"
                                    Click="OnCancelRun" IsEnabled="False" />
                        </StackPanel>

                        <!--
                            Said before anything is committed rather than after.
                            Stopping a run does not unmake a task it already
                            created with your approval.
                        -->
                        <TextBlock Opacity="0.6" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Text="Stopping a run cancels what has not happened yet. Anything you already approved stays." />
                    </StackPanel>

                    <Grid Grid.Column="1" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="2">
                            <TextBlock x:Name="RunStatusText"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />

                            <TextBlock x:Name="RunDetailText" Opacity="0.7" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>

                        <!--
                            Labelled before it is read, every time. This is what a
                            model said; it is not a finding AgencyOS has made.
                        -->
                        <InfoBar Grid.Row="1" x:Name="ResultNotice" Severity="Informational"
                                 IsOpen="False" IsClosable="False"
                                 Title="This is what the model said"
                                 Message="It is a draft, not a record. Nothing here has been filed against any person, deal or contract." />

                        <ScrollViewer Grid.Row="2">
                            <TextBlock x:Name="ResultText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Approvals" IsClosable="False">
                <Grid ColumnSpacing="16" Padding="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <InfoBar Grid.Row="0" x:Name="ApprovalsEmpty" Severity="Success"
                                 IsOpen="False" IsClosable="False"
                                 Title="Nothing is waiting for you" />

                        <ListView Grid.Row="1" x:Name="ApprovalList"
                                  AutomationProperties.Name="Approvals" SelectionMode="Single"
                                  SelectionChanged="OnApprovalSelected">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="4,6" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}, ConverterParameter=AiApproval}">
                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ToolName}" Opacity="0.7"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                        <TextBlock Text="{Binding ExpiresAt}" Opacity="0.5"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock x:Name="ApprovalHeading"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   TextWrapping="Wrap" />

                        <TextBlock x:Name="ApprovalEffect" Opacity="0.7" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}" />

                        <TextBlock x:Name="ApprovalExpiry" Opacity="0.7"
                                   Style="{StaticResource CaptionTextBlockStyle}" />

                        <!--
                            The exact arguments, as AgencyOS validated them. Never
                            the model's own account of what it asked for.
                        -->
                        <TextBlock Text="Exactly what would happen"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <ScrollViewer MaxHeight="220">
                            <TextBlock x:Name="ApprovalArguments" FontFamily="Consolas"
                                       TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </ScrollViewer>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="RejectButton" Content="Reject" Click="OnReject"
                                    Style="{StaticResource AccentButtonStyle}" IsEnabled="False" />

                            <Button x:Name="ApproveButton" Content="Approve and run"
                                    Click="OnApprove" IsEnabled="False" />
                        </StackPanel>

                        <InfoBar x:Name="ExecutionBar" IsOpen="False" IsClosable="False" />
                    </StackPanel>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Runs" IsClosable="False">
                <Grid RowSpacing="8" Padding="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="RunStatusFilter" AutomationProperties.Name="Run status" MinWidth="200"
                                  PlaceholderText="Any status"
                                  SelectionChanged="OnRunFilterChanged" />

                        <Button Content="Refresh" Click="OnRefreshRuns" />
                    </StackPanel>

                    <!--
                        Said plainly, because a run history is the one place a
                        question somebody asked is written down.
                    -->
                    <TextBlock Grid.Row="1" Opacity="0.6" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Text="Your runs. Nobody else can read them, and you cannot read anybody else's." />

                    <ListView Grid.Row="2" x:Name="RunList"
                              AutomationProperties.Name="Runs" SelectionMode="Single"
                              SelectionChanged="OnRunSelected">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="4,6" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}, ConverterParameter=AgentRun}">
                                    <TextBlock Text="{Binding Task}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Kind, Converter={StaticResource DisplayLabel}}" Opacity="0.7"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock Text="{Binding StartedAt}" Opacity="0.5"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Trace" IsClosable="False">
                <Grid RowSpacing="8" Padding="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--
                        The point of the trace. Every line says whether the model
                        asked or AgencyOS acted, and a reader never has to guess.
                    -->
                    <TextBlock Grid.Row="0" Opacity="0.7" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Text="What happened, in order. Each line says whether the model asked for something or AgencyOS did something." />

                    <ListView Grid.Row="1" x:Name="StepList"
                              AutomationProperties.Name="Trace" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="4,6" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}, ConverterParameter=AgentStep}">
                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Kind, Converter={StaticResource DisplayLabel}}" Opacity="0.7"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock Text="{Binding OccurredAt}" Opacity="0.5"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Policy" IsClosable="False">
                <Grid ColumnSpacing="16" Padding="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="440" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="8">
                        <TextBlock Text="What may leave AgencyOS"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />

                        <!--
                            A different question from authorization, and worded so
                            nobody reads it as the same one.
                        -->
                        <TextBlock Opacity="0.7" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Text="Separate from who may read what. This decides what AgencyOS may transmit to a model provider at all. Material marked Restricted is never transmitted, at any setting." />

                        <ListView x:Name="PolicyList"
                                  AutomationProperties.Name="Policies" SelectionMode="Single"
                                  SelectionChanged="OnPolicySelected">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="4,6" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}, ConverterParameter=AiPolicy}">
                                        <TextBlock Text="{Binding ProviderKey}" />
                                        <TextBlock Text="{Binding MaximumSensitivity}" Opacity="0.7"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel Spacing="6">
                            <ToggleSwitch x:Name="PolicyEnabled" Header="Enabled"
                                          OffContent="Nothing is transmitted" OnContent="Transmission permitted" />

                            <ComboBox x:Name="PolicyCeiling" MinWidth="380"
                                      Header="Most sensitive material permitted" />

                            <CheckBox x:Name="PolicyWrites"
                                      Content="Allow the model to propose changes for approval" />

                            <Button x:Name="PolicySave" Content="Save" Click="OnSavePolicy"
                                    IsEnabled="False" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Column="1" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="What the Research Copilot may do"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />

                        <ListView Grid.Row="1" x:Name="ToolList"
                                  AutomationProperties.Name="Tools" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="4,6" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}, ConverterParameter=AiTool}" AutomationProperties.HelpText="{Binding Description}">
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Name}" Opacity="0.7"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                        <TextBlock Text="{Binding RequiredPermission}" Opacity="0.5"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock Grid.Row="2" Text="Models this build can call"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />

                        <ListView Grid.Row="3" x:Name="ModelList"
                                  AutomationProperties.Name="Models" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="4,6" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}, ConverterParameter=AiModel}">
                                        <TextBlock Text="{Binding Key}" />
                                        <TextBlock Text="{Binding ProviderKey}" Opacity="0.7"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>
