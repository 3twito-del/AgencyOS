<Application
    x:Class="AgencyOS.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="using:AgencyOS.Windows.Presentation">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Presentation converters, declared once.

                RowLabel gives a list row the name a screen reader announces.
                Without it a templated row falls back to ToString() on the bound
                record, which prints every property it has - 115 rows across
                twelve surfaces were reciting their own identifiers
                (AOS-R001-003).

                DisplayLabel writes a domain token as the words a person reads,
                so a row says "Talent employment" where the record holds
                TalentEmployment (AOS-R001-012). Neither converts back: both are
                derived on the way to a screen and nothing parses them.
            -->
            <presentation:RowLabelConverter x:Key="RowLabel" />
            <presentation:DisplayLabelConverter x:Key="DisplayLabel" />
            <presentation:PresentVisibilityConverter x:Key="PresentVisibility" />
            <presentation:IsoDateConverter x:Key="IsoDate" />

            <!--
                Money carries its currency. Every Finance row bound the bare
                decimal out of MoneyResponse and dropped Currency, so a screen
                holding two currencies showed rows nothing could tell apart
                (F-11). This is the same MoneyFormatting the summaries use.
            -->
            <presentation:MoneyConverter x:Key="Money" />

            <!--
                TaskWho, TaskWhen and TaskAbout bind the whole row rather than a
                field: whether a task projection may speak about ownership depends
                on which fields it declares, not on their values. Six surfaces list
                tasks and five decided separately what a row should say, so the
                wording is decided once in TaskLine.
            -->
            <presentation:TaskWhoConverter x:Key="TaskWho" />
            <presentation:TaskWhenConverter x:Key="TaskWhen" />
            <presentation:TaskAboutConverter x:Key="TaskAbout" />

            <!--
                TargetContact does the same for a pipeline target, which carries
                two people: the individual dealt with at the counterparty, and the
                internal member responsible. The row showed the first and announced
                the second, so the two channels named different people.
            -->
            <presentation:TargetContactConverter x:Key="TargetContact" />

            <!--
                Dense list rows. A professional workstation shows more rows, not
                bigger ones: docs/12_WINDOWS_NATIVE.md asks for dense tables over
                consumer card layouts.
            -->
            <DataTemplate x:Key="TaskTemplate">
                <Grid Padding="4,3" ColumnSpacing="8" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />

                        <!--
                            The subject was here as a bare name, in the position a
                            byline occupies, and a blind operator read it as who was
                            accountable. It is genuinely useful on a list that spans
                            clients - it is how you tell rows apart - so it stays,
                            labelled, and the owner is now beside it. Two identities
                            on one row cannot be confused for each other the way one
                            unlabelled identity could.
                        -->
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Opacity="0.6"
                            Text="{Binding Converter={StaticResource TaskAbout}}" />
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Opacity="0.6"
                            Text="{Binding Converter={StaticResource TaskWho}}" />
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Opacity="0.6"
                            Text="{Binding Converter={StaticResource TaskWhen}}" />
                    </StackPanel>

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.7"
                        Text="{Binding Priority, Converter={StaticResource DisplayLabel}}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="PersonRowTemplate">
                <Grid Padding="4,3" ColumnSpacing="8" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Opacity="0.6"
                            Text="{Binding Title}" />
                    </StackPanel>

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.6"
                        Text="{Binding PrimaryCompanyName}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="CompanyRowTemplate">
                <Grid Padding="4,3" ColumnSpacing="8" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.6"
                        Text="{Binding Type, Converter={StaticResource DisplayLabel}}" />
                </Grid>
            </DataTemplate>

            <!--
                One recorded contact, with the longer account behind a disclosure.

                Shared rather than written per page. The Command Center rendered the
                detailed notes and the person's own surfaces did not, so an operator
                handed a name could read the summary of a call and never learn what
                the call was about. One template means the two surfaces cannot drift
                apart again about what a contact shows.
            -->
            <DataTemplate x:Key="InteractionTemplate">
                <StackPanel Padding="4,3" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}}">
                    <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.6"
                        Text="{Binding Type, Converter={StaticResource DisplayLabel}}" />

                    <!--
                        Collapsed, so the list stays scannable, and folded away
                        entirely when there is nothing to read. An Expander is
                        focusable and operable from the keyboard, which a trimmed
                        TextBlock is not.
                    -->
                    <Expander
                        Margin="0,4,0,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="Detailed notes"
                        Visibility="{Binding DetailedNotes, Converter={StaticResource PresentVisibility}}">
                        <Expander.Header>
                            <TextBlock Text="Detailed notes"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </Expander.Header>
                        <TextBlock Text="{Binding DetailedNotes}"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" />
                    </Expander>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="TimelineEntryTemplate">
                <Grid Padding="4,4" ColumnSpacing="10" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.6"
                        Width="150"
                        Text="{Binding OccurredAt}" />

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Opacity="0.6"
                            Text="{Binding Detail}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="RelationshipRowTemplate">
                <StackPanel Padding="4,3" AutomationProperties.Name="{Binding Converter={StaticResource RowLabel}}">
                    <TextBlock Text="{Binding Type, Converter={StaticResource DisplayLabel}}" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Opacity="0.6"
                        Text="{Binding To.Name}" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
