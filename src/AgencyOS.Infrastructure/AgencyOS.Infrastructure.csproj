<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />

    <!--
      Encryption at rest for stored OAuth credentials (ADR-0027). The Extensions
      package supplies the file-backed key ring the ALPHA deployment uses; the
      hosted API can substitute a managed key store without the infrastructure
      layer changing.
    -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Extensions" />
    <PackageReference Include="Microsoft.Extensions.Http" />

    <!--
      EF Core tooling support. Kept here rather than in the API so that migrations
      are authored against the assembly that owns the schema, and so the API host
      carries no design-time dependency. PrivateAssets keeps it out of consumers.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AgencyOS.Application/AgencyOS.Application.csproj" />
    <ProjectReference Include="../AgencyOS.Domain/AgencyOS.Domain.csproj" />
  </ItemGroup>

</Project>
