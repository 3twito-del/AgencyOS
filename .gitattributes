# Normalize line endings so a clean clone is identical on every machine.
# .editorconfig and .vscode/settings.json both specify LF; without this, a
# machine with core.autocrlf=true silently checks out CRLF.

* text=auto eol=lf

# Windows-native tooling that expects CRLF.
*.sln        text eol=crlf
*.ps1        text eol=crlf
*.cmd        text eol=crlf
*.bat        text eol=crlf

# Binary.
*.png        binary
*.jpg        binary
*.ico        binary
*.pdf        binary
*.msix       binary
*.pfx        binary
*.snk        binary
