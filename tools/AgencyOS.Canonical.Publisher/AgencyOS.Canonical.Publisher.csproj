<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AgencyOS canonical state publisher. Engineering tooling, not product.

    It executes an already-adjudicated canonical transition under
    docs/control-room/CANONICAL-PUBLISHER-CONTRACT.md: stage the accepted bytes,
    record a durable seal authorization, promote the staged bytes, and prove each
    step by remote readback. It has no semantic decision authority.

    It writes git state, but only through the command policy in
    Git/PublisherGit.cs: normal fast-forward pushes, no force, no reset, no
    rebase, no tag, no history rewriting. It references no product project, no
    detector project and no NuGet package.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AgencyOS.Canonical.Publisher</RootNamespace>
    <AssemblyName>AgencyOS.Canonical.Publisher</AssemblyName>
    <IsPackable>false</IsPackable>
    <AgencyOSStrict>true</AgencyOSStrict>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgencyOS.Tests.Canonical" />
  </ItemGroup>

</Project>
