<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AgencyOS canonical state detector. Engineering tooling, not product.

    It observes repository evidence and emits a Canonical Alert
    (docs/control-room/CANONICAL-DETECTOR.md). It is read-only by construction:
    it runs only an allowlist of read-only git subcommands, writes nothing but
    its own standard output, and has no path to the publisher. Nothing it
    produces is an adjudication.

    It references no product project and no NuGet package. The only external
    program it runs is git, which the build already requires.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AgencyOS.Canonical.Detector</RootNamespace>
    <AssemblyName>AgencyOS.Canonical.Detector</AssemblyName>
    <IsPackable>false</IsPackable>
    <AgencyOSStrict>true</AgencyOSStrict>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgencyOS.Tests.Canonical" />
  </ItemGroup>

</Project>
