<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integration tests run against a real PostgreSQL server, per
    docs/11_TESTING_AND_FORMAL_METHODS.md. There is no in-memory substitute:
    the append-only trigger, jsonb and text[] columns and the migration itself
    are database behavior, and a fake would verify none of them.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/AgencyOS.Api/AgencyOS.Api.csproj" />
    <ProjectReference Include="../../src/AgencyOS.Contracts/AgencyOS.Contracts.csproj" />
    <ProjectReference Include="../../src/AgencyOS.Infrastructure/AgencyOS.Infrastructure.csproj" />
  </ItemGroup>

</Project>
