# Claude local personal settings
.claude/settings.local.json

# AgencyOS local generated state/logs
.agencyos/

# Secrets
.env
.env.*
*.pfx
*.p12
*.key

# .NET
bin/
obj/

# VS / VS Code user-local
.vs/
*.user
*.suo

# AgencyOS build artifacts
artifacts/

# TLA+ toolchain output. The specification and its configuration are source;
# the translator's backup and TLC's state directory are not.
specs/states/
specs/*.old

# TLC writes an error-trace specification beside the module when it finds a
# counterexample. It is a diagnostic for one run, not a specification anybody
# maintains.
specs/*_TTrace_*.tla
specs/*_TTrace_*.bin

.fake
